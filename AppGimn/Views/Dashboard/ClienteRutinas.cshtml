@{
    ViewData["Title"] = "Mis Rutinas de Entrenamiento - AppGimn";
}

<!-- SUB-BARRA DE NAVEGACIÓN EXCLUSIVA PARA EL CLIENTE -->
<div class="bg-dark border-bottom border-secondary py-2 mb-4">
    <div class="container">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="saas-badge saas-badge-purple">
                    <i class="bi bi-journal-bookmark-fill me-1"></i> RUTINAS ASIGNADAS
                </span>
                <span class="text-white fw-bold d-none d-md-inline">AURA FITNESS CLUB</span>
            </div>
            <div class="nav nav-pills gap-1">
                <a asp-controller="Dashboard" asp-action="ClientePanel" class="nav-link btn-secondary-saas text-white btn-sm px-3">
                    <i class="bi bi-house-door me-1"></i> Mi Inicio
                </a>
                <a asp-controller="Dashboard" asp-action="ClienteRutinas" class="nav-link active bg-purple text-white btn-sm px-3">
                    <i class="bi bi-journal-bookmark me-1"></i> Mis Rutinas
                </a>
                <a asp-controller="Dashboard" asp-action="ClienteEvolucion" class="nav-link btn-secondary-saas text-white btn-sm px-3">
                    <i class="bi bi-graph-up-arrow me-1"></i> Mi Evolución
                </a>
                <a asp-controller="Dashboard" asp-action="ClienteClases" class="nav-link btn-secondary-saas text-white btn-sm px-3">
                    <i class="bi bi-calendar-check me-1"></i> Reservar Clases
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container pb-5">
    <!-- ENCABEZADO Y PLANIFICACIÓN DE LA SEMANA -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4 gap-3">
        <div>
            <h2 class="fw-bold text-white mb-1">
                <i class="bi bi-activity text-primary me-2"></i>Programa de Entrenamiento Hipertrofia & Fuerza B
            </h2>
            <p class="text-secondary small mb-0">Diseñado por el Head Coach Marcus Vance | Frecuencia: 4 Días por semana</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-purple btn-sm" onclick="alert('Iniciando temporizador de descanso de 90 segundos...')">
                <i class="bi bi-stopwatch me-1"></i> Temporizador de Descanso
            </button>
        </div>
    </div>

    <!-- PESTAÑAS DE DÍAS DE LA SEMANA -->
    <ul class="nav nav-tabs border-secondary mb-4 gap-2" id="rutinasTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active btn-secondary-saas text-white fw-bold px-4 py-2" id="dia1-tab" data-bs-toggle="tab" data-bs-target="#dia1" type="button" role="tab">
                Lunes: Pecho & Tríceps
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link btn-secondary-saas text-white fw-bold px-4 py-2" id="dia2-tab" data-bs-toggle="tab" data-bs-target="#dia2" type="button" role="tab">
                Miércoles: Espalda & Bíceps
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link btn-secondary-saas text-white fw-bold px-4 py-2" id="dia3-tab" data-bs-toggle="tab" data-bs-target="#dia3" type="button" role="tab">
                Viernes: Piernas & Abdomen
            </button>
        </li>
    </ul>

    <!-- CONTENIDO DE LOS EJERCICIOS VISUALES -->
    <div class="tab-content" id="rutinasTabsContent">
        <!-- DÍA 1: PECHO Y TRÍCEPS -->
        <div class="tab-pane fade show active" id="dia1" role="tabpanel">
            <div class="row g-4">
                <!-- EJERCICIO 1 -->
                <div class="col-md-6">
                    <div class="saas-card overflow-hidden h-100">
                        <img src="~/images/landing/weight_training.jpg" alt="Press Inclinado" class="img-16-9" style="height: 220px; object-fit: cover;" />
                        <div class="p-4">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <h4 class="fw-bold text-white mb-0">1. Press de Banca Inclinado con Barra</h4>
                                <span class="saas-badge saas-badge-purple">4 Series</span>
                            </div>
                            <p class="text-secondary small mb-3">
                                Mantener escápulas retráctiles y descender la barra de forma controlada hasta el esternón.
                            </p>
                            <div class="d-flex align-items-center justify-content-between p-3 rounded bg-dark border border-secondary">
                                <div><strong class="text-white">Repeticiones:</strong> 10 - 12</div>
                                <div><strong class="text-white">Carga sugerida:</strong> <span class="text-primary fw-bold">60 kg</span></div>
                                <div><strong class="text-white">Descanso:</strong> 90s</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- EJERCICIO 2 -->
                <div class="col-md-6">
                    <div class="saas-card overflow-hidden h-100">
                        <img src="~/images/landing/aura_strength.jpg" alt="Aperturas" class="img-16-9" style="height: 220px; object-fit: cover;" />
                        <div class="p-4">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <h4 class="fw-bold text-white mb-0">2. Aperturas en Banco Plano con Mancuernas</h4>
                                <span class="saas-badge saas-badge-purple">3 Series</span>
                            </div>
                            <p class="text-secondary small mb-3">
                                Codos ligeramente flexionados. Enfocarse en la máxima extensión del pectoral mayor.
                            </p>
                            <div class="d-flex align-items-center justify-content-between p-3 rounded bg-dark border border-secondary">
                                <div><strong class="text-white">Repeticiones:</strong> 12</div>
                                <div><strong class="text-white">Carga sugerida:</strong> <span class="text-primary fw-bold">18 kg c/u</span></div>
                                <div><strong class="text-white">Descanso:</strong> 60s</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- DÍA 2: ESPALDA Y BÍCEPS -->
        <div class="tab-pane fade" id="dia2" role="tabpanel">
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="saas-card overflow-hidden h-100">
                        <img src="~/images/landing/aura_hero.jpg" alt="Dominadas" class="img-16-9" style="height: 220px; object-fit: cover;" />
                        <div class="p-4">
                            <h4 class="fw-bold text-white mb-2">1. Dominadas Abiertas al Pecho</h4>
                            <p class="text-secondary small mb-3">Tracción completa llevando la barbilla por encima de la barra.</p>
                            <div class="d-flex align-items-center justify-content-between p-3 rounded bg-dark border border-secondary">
                                <div><strong class="text-white">Series:</strong> 4</div>
                                <div><strong class="text-white">Repeticiones:</strong> 8 - 10</div>
                                <div><strong class="text-white">Carga:</strong> Peso Corporal</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- DÍA 3: PIERNAS Y ABDOMEN -->
        <div class="tab-pane fade" id="dia3" role="tabpanel">
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="saas-card overflow-hidden h-100">
                        <img src="~/images/landing/aura_strength.jpg" alt="Sentadillas" class="img-16-9" style="height: 220px; object-fit: cover;" />
                        <div class="p-4">
                            <h4 class="fw-bold text-white mb-2">1. Sentadilla Libre Profunda con Barra</h4>
                            <p class="text-secondary small mb-3">Rodillas alineadas con las puntas de los pies. Espina neutra.</p>
                            <div class="d-flex align-items-center justify-content-between p-3 rounded bg-dark border border-secondary">
                                <div><strong class="text-white">Series:</strong> 4</div>
                                <div><strong class="text-white">Repeticiones:</strong> 10</div>
                                <div><strong class="text-white">Carga:</strong> 85 kg</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
