@{
    ViewData["Title"] = "Mis Rutinas de Entrenamiento - AppGimn Premium";
}

<div class="cliente-layout">
    <partial name="_ClienteSidebar" />

    <div class="cliente-content-canvas">
        <!-- ENCABEZADO Y PLANIFICACIÓN DE LA SEMANA -->
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4 gap-3">
            <div>
                <h1 class="fw-bold text-dark mb-1" style="font-size: 2.1rem; letter-spacing: -0.02em;">
                    <i class="bi bi-activity text-purple me-2" style="color: #8B3DFF;"></i>Programa de Entrenamiento: Hipertrofia & Fuerza B
                </h1>
                <p class="text-muted small mb-0">Diseñado por el Head Coach Marcus Vance | Frecuencia: 4 Días por semana</p>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-purple btn-sm py-2 px-3 fw-bold" onclick="alert('Iniciando temporizador de descanso de 90 segundos...')">
                    <i class="bi bi-stopwatch me-1"></i> Temporizador de Descanso
                </button>
            </div>
        </div>

        <!-- PESTAÑAS DE DÍAS DE LA SEMANA -->
        <ul class="nav nav-pills mb-4 gap-2" id="rutinasTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active btn-purple fw-bold px-4 py-2" id="dia1-tab" data-bs-toggle="tab" data-bs-target="#dia1" type="button" role="tab">
                    Lunes: Pecho & Tríceps
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link btn-outline-secondary text-dark fw-bold px-4 py-2" id="dia2-tab" data-bs-toggle="tab" data-bs-target="#dia2" type="button" role="tab">
                    Miércoles: Espalda & Bíceps
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link btn-outline-secondary text-dark fw-bold px-4 py-2" id="dia3-tab" data-bs-toggle="tab" data-bs-target="#dia3" type="button" role="tab">
                    Viernes: Piernas & Abdomen
                </button>
            </li>
        </ul>

        <!-- CONTENIDO DE LOS EJERCICIOS VISUALES -->
        <div class="tab-content" id="rutinasTabsContent">
            <!-- DÍA 1: PECHO Y TRÍCEPS -->
            <div class="tab-pane fade show active" id="dia1" role="tabpanel">
                <div class="row g-4">
                    <!-- EJERCICIO 1 -->
                    <div class="col-md-6">
                        <div class="card-white overflow-hidden h-100 p-0">
                            <img src="~/images/landing/weight_training.jpg" alt="Press Inclinado" class="w-100" style="height: 220px; object-fit: cover;" />
                            <div class="p-4">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <h4 class="fw-bold text-dark mb-0">1. Press de Banca Inclinado con Barra</h4>
                                    <span class="badge bg-purple text-white px-3 py-1 rounded-pill" style="background-color: #8B3DFF;">4 Series</span>
                                </div>
                                <p class="text-muted small mb-3">
                                    Mantener escápulas retráctiles y descender la barra de forma controlada hasta el esternón.
                                </p>
                                <div class="d-flex align-items-center justify-content-between p-3 rounded-3" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                                    <div><strong class="text-dark">Repeticiones:</strong> 10 - 12</div>
                                    <div><strong class="text-dark">Carga sugerida:</strong> <span class="text-purple fw-bold" style="color: #8B3DFF;">60 kg</span></div>
                                    <div><strong class="text-dark">Descanso:</strong> 90s</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- EJERCICIO 2 -->
                    <div class="col-md-6">
                        <div class="card-white overflow-hidden h-100 p-0">
                            <img src="~/images/landing/aura_strength.jpg" alt="Aperturas" class="w-100" style="height: 220px; object-fit: cover;" />
                            <div class="p-4">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <h4 class="fw-bold text-dark mb-0">2. Aperturas en Banco Plano con Mancuernas</h4>
                                    <span class="badge bg-purple text-white px-3 py-1 rounded-pill" style="background-color: #8B3DFF;">3 Series</span>
                                </div>
                                <p class="text-muted small mb-3">
                                    Codos ligeramente flexionados. Enfocarse en la máxima extensión del pectoral mayor.
                                </p>
                                <div class="d-flex align-items-center justify-content-between p-3 rounded-3" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                                    <div><strong class="text-dark">Repeticiones:</strong> 12</div>
                                    <div><strong class="text-dark">Carga sugerida:</strong> <span class="text-purple fw-bold" style="color: #8B3DFF;">18 kg c/u</span></div>
                                    <div><strong class="text-dark">Descanso:</strong> 60s</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- DÍA 2: ESPALDA Y BÍCEPS -->
            <div class="tab-pane fade" id="dia2" role="tabpanel">
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="card-white overflow-hidden h-100 p-0">
                            <img src="~/images/landing/aura_hero.jpg" alt="Dominadas" class="w-100" style="height: 220px; object-fit: cover;" />
                            <div class="p-4">
                                <h4 class="fw-bold text-dark mb-2">1. Dominadas Abiertas al Pecho</h4>
                                <p class="text-muted small mb-3">Tracción completa llevando la barbilla por encima de la barra.</p>
                                <div class="d-flex align-items-center justify-content-between p-3 rounded-3" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                                    <div><strong class="text-dark">Series:</strong> 4</div>
                                    <div><strong class="text-dark">Repeticiones:</strong> 8 - 10</div>
                                    <div><strong class="text-dark">Carga:</strong> Peso Corporal</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- DÍA 3: PIERNAS Y ABDOMEN -->
            <div class="tab-pane fade" id="dia3" role="tabpanel">
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="card-white overflow-hidden h-100 p-0">
                            <img src="~/images/landing/aura_strength.jpg" alt="Sentadillas" class="w-100" style="height: 220px; object-fit: cover;" />
                            <div class="p-4">
                                <h4 class="fw-bold text-dark mb-2">1. Sentadilla Libre Profunda con Barra</h4>
                                <p class="text-muted small mb-3">Rodillas alineadas con las puntas de los pies. Espina neutra.</p>
                                <div class="d-flex align-items-center justify-content-between p-3 rounded-3" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                                    <div><strong class="text-dark">Series:</strong> 4</div>
                                    <div><strong class="text-dark">Repeticiones:</strong> 10</div>
                                    <div><strong class="text-dark">Carga:</strong> 85 kg</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
