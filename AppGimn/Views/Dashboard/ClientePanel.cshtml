@{
    ViewData["Title"] = "Mi Portal de Entrenamiento - AppGimn";
}

<!-- SUB-BARRA DE NAVEGACIÓN EXCLUSIVA PARA EL CLIENTE -->
<div class="bg-dark border-bottom border-secondary py-2 mb-4">
    <div class="container">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="saas-badge saas-badge-purple">
                    <i class="bi bi-person-heart me-1"></i> PORTAL DEL SOCIO
                </span>
                <span class="text-white fw-bold d-none d-md-inline">AURA FITNESS CLUB</span>
            </div>
            <div class="nav nav-pills gap-1">
                <a asp-controller="Dashboard" asp-action="ClientePanel" class="nav-link active bg-purple text-white btn-sm px-3">
                    <i class="bi bi-house-door me-1"></i> Mi Inicio
                </a>
                <a asp-controller="Dashboard" asp-action="ClienteRutinas" class="nav-link btn-secondary-saas text-white btn-sm px-3">
                    <i class="bi bi-journal-bookmark me-1"></i> Mis Rutinas
                </a>
                <a asp-controller="Dashboard" asp-action="ClienteEvolucion" class="nav-link btn-secondary-saas text-white btn-sm px-3">
                    <i class="bi bi-graph-up-arrow me-1"></i> Mi Evolución
                </a>
                <a asp-controller="Dashboard" asp-action="ClienteClases" class="nav-link btn-secondary-saas text-white btn-sm px-3">
                    <i class="bi bi-calendar-check me-1"></i> Reservar Clases
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container pb-5">
    <!-- HERO GIGANTE VISUAL DE BIENVENIDA CON FOTO DEL GIMNASIO -->
    <div class="saas-card overflow-hidden p-0 mb-4 position-relative shadow-lg" style="border: 2px solid var(--primary);">
        <div class="position-relative">
            <img src="~/images/landing/aura_hero.jpg" alt="Aura Gym Hero" class="w-100" style="height: 260px; object-fit: cover; filter: brightness(0.4);" />
            <div class="position-absolute bottom-0 start-0 p-4 p-md-5 text-white w-100 d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3" style="background: linear-gradient(0deg, rgba(18,18,18,0.95) 0%, rgba(18,18,18,0) 100%);">
                <div>
                    <span class="saas-badge saas-badge-success mb-2">
                        <i class="bi bi-patch-check-fill me-1"></i> MEMBRESÍA VIP ACTIVA - @ViewBag.MembresiaNombre
                    </span>
                    <h1 class="display-4 fw-bold text-white mb-1">¡Hola de nuevo, @ViewBag.ClienteNombre!</h1>
                    <p class="text-secondary mb-0 fs-5">Socio oficial de Aura Fitness Club desde @ViewBag.MiembroDesde</p>
                </div>
                <div class="d-flex gap-2">
                    <a asp-controller="Dashboard" asp-action="ClienteClases" class="btn btn-purple btn-lg px-4 py-3">
                        <i class="bi bi-calendar-plus me-1"></i> Reservar Clase Hoy
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- TARJETAS GRANDES VISUALES -->
    <div class="row g-4 mb-4">
        <!-- 1. CARNET DIGITAL DE SOCIO CON CÓDIGO QR -->
        <div class="col-lg-4">
            <div class="saas-card p-4 h-100 d-flex flex-column justify-content-between text-center" style="background: linear-gradient(145deg, rgba(30,30,30,1) 0%, rgba(43,43,43,0.9) 100%); border: 1px solid var(--primary);">
                <div>
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <span class="text-muted small fw-bold text-uppercase">Carnet Digital de Socio</span>
                        <span class="saas-badge saas-badge-purple">VIP ACCESS</span>
                    </div>
                    <div class="rounded-circle mx-auto d-flex align-items-center justify-content-center mb-3 shadow" style="width: 80px; height: 80px; border: 3px solid var(--primary-light); overflow: hidden; background-color: var(--bg-surface-variant);">
                        @if (!string.IsNullOrEmpty(ViewBag.ClienteFoto as string))
                        {
                            <img src="@ViewBag.ClienteFoto" class="w-100 h-100 object-fit-cover" alt="@ViewBag.ClienteNombre" />
                        }
                        else
                        {
                            <span class="fw-bold fs-2 text-white">CG</span>
                        }
                    </div>
                    <h4 class="fw-bold text-white mb-1">@ViewBag.ClienteNombre</h4>
                    <p class="text-secondary small mb-3">DNI: <code>11223344</code> | ID Socio: #AURA-9842</p>

                    <!-- QR CODE PLACEHOLDER VISUAL -->
                    <div class="p-3 bg-white rounded-3 mx-auto mb-3 d-inline-block shadow-sm">
                        <img src="https://api.qrserver.com/v1/create-qr-code/?size=130x130&data=AURA-SOCIO-11223344" alt="Código QR de Acceso" style="width: 130px; height: 130px;" />
                    </div>
                    <div class="small text-muted mb-0"><i class="bi bi-qr-code-scan text-primary me-1"></i> Muestra este código en el molinete para ingresar</div>
                </div>
            </div>
        </div>

        <!-- 2. RUTINA ASIGNADA CON FOTO DEL ENTRENAMIENTO -->
        <div class="col-lg-4">
            <div class="saas-card overflow-hidden h-100 d-flex flex-column justify-content-between">
                <div>
                    <div class="position-relative">
                        <img src="~/images/landing/weight_training.jpg" alt="Rutina de Musculación" class="img-16-9" style="height: 180px; object-fit: cover;" />
                        <span class="position-absolute top-0 end-0 m-3 saas-badge saas-badge-success">DÍA 2 DE 4</span>
                    </div>
                    <div class="p-4">
                        <h4 class="fw-bold text-white mb-2">Rutina de hoy: Hipertrofia Pecho & Tríceps</h4>
                        <p class="text-secondary small mb-3">
                            4 Ejercicios de alta intensidad diseñados por tu Coach Marcus Vance.
                        </p>
                        <div class="d-flex align-items-center justify-content-between small text-muted mb-2">
                            <span>Progreso de la sesión:</span>
                            <span class="text-primary fw-bold">75% Completado</span>
                        </div>
                        <div class="progress bg-dark" style="height: 8px;">
                            <div class="progress-bar bg-purple" style="width: 75%;"></div>
                        </div>
                    </div>
                </div>
                <div class="p-4 pt-0">
                    <a asp-controller="Dashboard" asp-action="ClienteRutinas" class="btn btn-purple w-100">
                        <i class="bi bi-play-fill me-1"></i> Iniciar Sesión de Entrenamiento
                    </a>
                </div>
            </div>
        </div>

        <!-- 3. CLASE PRÓXIMA CON FOTO -->
        <div class="col-lg-4">
            <div class="saas-card overflow-hidden h-100 d-flex flex-column justify-content-between">
                <div>
                    <div class="position-relative">
                        <img src="~/images/landing/group_classes.jpg" alt="Clase de Pilates" class="img-16-9" style="height: 180px; object-fit: cover;" />
                        <span class="position-absolute top-0 end-0 m-3 saas-badge saas-badge-purple">HOY 18:00 HS</span>
                    </div>
                    <div class="p-4">
                        <h4 class="fw-bold text-white mb-2">Pilates Reformer & Postura</h4>
                        <p class="text-secondary small mb-3">
                            Instructora: Elena Rostova. Salón Principal A.
                        </p>
                        <div class="saas-card p-3" style="background-color: var(--bg-surface-variant);">
                            <div class="d-flex align-items-center justify-content-between small">
                                <span class="text-muted"><i class="bi bi-geo-alt-fill text-danger me-1"></i> Salón 2 de Pilates</span>
                                <span class="text-success fw-bold"><i class="bi bi-check-circle-fill me-1"></i> Lugar Confirmado</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="p-4 pt-0">
                    <a asp-controller="Dashboard" asp-action="ClienteClases" class="btn btn-secondary-saas w-100">
                        <i class="bi bi-calendar-event me-1"></i> Ver Todas mis Clases
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- GRÁFICO VISUAL DE EVOLUCIÓN FÍSICA Y TARJETAS DE PROGRESO -->
    <div class="row g-4">
        <!-- GRÁFICO INTERACTIVO DE PESO Y MÚSCULO -->
        <div class="col-lg-8">
            <div class="saas-card p-4">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <div>
                        <h4 class="fw-bold text-white mb-1">
                            <i class="bi bi-graph-up-arrow text-primary me-2"></i>Evolución de Peso y Composición Corporal
                        </h4>
                        <p class="text-secondary small mb-0">Progreso histórico registrado por tu entrenador en las evaluaciones</p>
                    </div>
                    <a asp-controller="Dashboard" asp-action="ClienteEvolucion" class="btn btn-outline-purple btn-sm">
                        Ver Detalle Completo
                    </a>
                </div>

                <!-- CANVAS PARA EL GRÁFICO CON CHART.JS -->
                <div style="position: relative; height: 260px; width: 100%;">
                    <canvas id="chartEvolucionCliente"></canvas>
                </div>
            </div>
        </div>

        <!-- COACHING Y MENSAJES CON ENTRENADOR -->
        <div class="col-lg-4">
            <div class="saas-card p-4 h-100 d-flex flex-column justify-content-between">
                <div>
                    <h5 class="fw-bold text-white mb-3">
                        <i class="bi bi-chat-heart text-danger me-2"></i>Tu Personal Trainer
                    </h5>
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold fs-4" style="width: 54px; height: 54px;">
                            MV
                        </div>
                        <div>
                            <h5 class="fw-bold text-white mb-0">Marcus Vance</h5>
                            <span class="small text-muted">Head Coach & Biomecánica</span>
                        </div>
                    </div>
                    <div class="saas-card p-3 mb-3" style="background-color: var(--bg-surface-variant);">
                        <div class="small text-warning fw-bold mb-1"><i class="bi bi-quote"></i> Mensaje de tu Entrenador:</div>
                        <p class="small text-secondary mb-0">
                            "¡Carlos, venís excelente con la bajada de masa grasa! Mantené el ritmo en las series de pecho de hoy. Nos vemos el viernes para la re-evaluación."
                        </p>
                    </div>
                </div>
                <button class="btn btn-purple w-100 py-3" onclick="alert('Abriendo chat privado con Marcus Vance...')">
                    <i class="bi bi-chat-fill me-1"></i> Abrir Chat con el Coach
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- CHART.JS PARA EL GRÁFICO DE EVOLUCIÓN DEL SOCIO -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const ctx = document.getElementById('chartEvolucionCliente').getContext('2d');
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul'],
                    datasets: [
                        {
                            label: 'Peso Corporal (kg)',
                            data: [82.5, 81.0, 80.2, 79.5, 79.0, 78.8, 78.5],
                            borderColor: '#8B3DFF',
                            backgroundColor: 'rgba(139, 61, 255, 0.15)',
                            borderWidth: 3,
                            fill: true,
                            tension: 0.4
                        },
                        {
                            label: '% Grasa Corporal',
                            data: [18.2, 17.5, 16.8, 16.0, 15.2, 14.8, 14.2],
                            borderColor: '#22C55E',
                            borderWidth: 2,
                            borderDash: [5, 5],
                            tension: 0.4
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            labels: { color: '#ffffff', font: { family: 'Plus Jakarta Sans', size: 12 } }
                        }
                    },
                    scales: {
                        x: {
                            grid: { color: 'rgba(255, 255, 255, 0.1)' },
                            ticks: { color: '#C9C9C9' }
                        },
                        y: {
                            grid: { color: 'rgba(255, 255, 255, 0.1)' },
                            ticks: { color: '#C9C9C9' }
                        }
                    }
                }
            });
        });
    </script>
}
