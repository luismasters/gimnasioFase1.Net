@{
    ViewData["Title"] = "Perfil del Socio - AppGimn Premium";
    string nombreSocio = ViewBag.ClienteNombre as string ?? "Carlos Gómez";
    string fotoSocio = ViewBag.ClienteFoto as string ?? "";
    string membresiaSocio = ViewBag.MembresiaNombre as string ?? "Pase Premium 24/7";
    string miembroDesde = ViewBag.MiembroDesde as string ?? "01/03/2024";
}

<div class="cliente-layout">
    <partial name="_ClienteSidebar" />

    <div class="cliente-content-canvas">
        <!-- ENCABEZADO DE PÁGINA ESTILO SAAS ELEGANTE -->
        <div class="mb-4">
            <h1 class="fw-bold text-dark mb-1" style="font-size: 2.1rem; letter-spacing: -0.02em;">Perfil del Socio & Mi Panel</h1>
            <p class="text-muted mb-0">Gestiona los detalles de tu cuenta, membresía activa y preferencias de entrenamiento.</p>
        </div>

        <div class="row g-4">
            <!-- COLUMNA IZQUIERDA: AVATAR + CARNET DE ACCESO (4 COLUMNAS) -->
            <div class="col-lg-4">
                <!-- TARJETA 1: AVATAR E IDENTIFICACIÓN -->
                <div class="card-white text-center">
                    <div class="position-relative d-inline-block mb-3">
                        @if (!string.IsNullOrEmpty(fotoSocio))
                        {
                            <img src="@fotoSocio" class="rounded-circle object-fit-cover shadow-sm border border-3 border-purple" style="width: 110px; height: 110px;" alt="@nombreSocio" />
                        }
                        else
                        {
                            <div class="rounded-circle bg-purple text-white d-flex align-items-center justify-content-center shadow-sm border border-3 border-purple mx-auto" style="width: 110px; height: 110px; font-size: 2.8rem; background-color: #8B3DFF;">
                                @nombreSocio.Substring(0, Math.Min(2, nombreSocio.Length)).ToUpper()
                            </div>
                        }
                    </div>
                    <h3 class="fw-bold text-dark mb-1">@nombreSocio</h3>
                    <p class="text-muted small mb-3">carlos.gomez@gmail.com</p>
                    <span class="badge px-3 py-2 rounded-pill fw-bold text-uppercase" style="background-color: rgba(139, 61, 255, 0.15); color: #8B3DFF; border: 1px solid rgba(139, 61, 255, 0.3); font-size: 0.75rem;">
                        SOCIO VIP ACTIVO
                    </span>
                </div>

                <!-- TARJETA 2: ESTADO DE SEGURIDAD & CARNET QR -->
                <div class="card-white">
                    <div class="card-white-header">
                        <i class="bi bi-shield-check text-purple" style="color: #8B3DFF;"></i> Estado de Cuenta & Acceso
                    </div>
                    <div class="d-flex flex-column gap-3 mb-3">
                        <div class="d-flex align-items-center justify-content-between p-2.5 rounded-3" style="background-color: #f8fafc;">
                            <span class="text-muted small font-semibold">Membresía Activa</span>
                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">
                                <i class="bi bi-check-circle-fill me-1"></i> Al día
                            </span>
                        </div>
                        <div class="d-flex align-items-center justify-content-between p-2.5 rounded-3" style="background-color: #f8fafc;">
                            <span class="text-muted small font-semibold">Último Ingreso</span>
                            <span class="fw-bold text-dark small">Hoy, 08:30 AM</span>
                        </div>
                        <div class="d-flex align-items-center justify-content-between p-2.5 rounded-3" style="background-color: #f8fafc;">
                            <span class="text-muted small font-semibold">Vencimiento</span>
                            <span class="fw-bold text-purple small" style="color: #8B3DFF;">28/08/2026</span>
                        </div>
                    </div>

                    <div class="text-center pt-2 border-top border-slate-100">
                        <div class="p-3 bg-white rounded-3 d-inline-block shadow-sm mb-2 border border-slate-200">
                            <img src="https://api.qrserver.com/v1/create-qr-code/?size=120x120&data=AURA-SOCIO-11223344" alt="QR Acceso" style="width: 120px; height: 120px;" />
                        </div>
                        <div class="small text-muted" style="font-size: 0.78rem;">
                            <i class="bi bi-qr-code-scan text-purple me-1" style="color: #8B3DFF;"></i> Muestra este código QR en el molinete
                        </div>
                    </div>
                </div>
            </div>

            <!-- COLUMNA DERECHA: FORMULARIOS DE INFORMACIÓN PERSONAL Y CONTRASEÑA (8 COLUMNAS) -->
            <div class="col-lg-8">
                <!-- TARJETA 1: INFORMACIÓN PERSONAL -->
                <div class="card-white">
                    <div class="card-white-header">
                        <i class="bi bi-person-lines-fill text-purple" style="color: #8B3DFF;"></i> Información Personal
                    </div>

                    <form onsubmit="event.preventDefault(); alert('¡Información personal actualizada correctamente!');">
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label-light">Nombre</label>
                                <input type="text" class="form-control form-control-light" value="Carlos" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label-light">Apellido</label>
                                <input type="text" class="form-control form-control-light" value="Gómez" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label-light">Correo Electrónico</label>
                            <input type="email" class="form-control form-control-light" value="carlos.gomez@gmail.com" />
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label-light">Número de Teléfono</label>
                                <input type="text" class="form-control form-control-light" value="+54 11 4455-6677" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label-light">Ubicación / Ciudad</label>
                                <input type="text" class="form-control form-control-light" value="Buenos Aires, Argentina" />
                            </div>
                        </div>

                        <div class="text-end">
                            <button type="submit" class="btn btn-purple px-4 py-2.5 fw-bold" style="background-color: #8B3DFF; border: none; border-radius: 10px;">
                                Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>

                <!-- TARJETA 2: ENTRENAMIENTO Y RUTINA ACTIVA DE HOY -->
                <div class="card-white">
                    <div class="card-white-header justify-content-between">
                        <div>
                            <i class="bi bi-activity text-purple" style="color: #8B3DFF;"></i> Entrenamiento & Rutina de Hoy
                        </div>
                        <a asp-controller="Dashboard" asp-action="ClienteRutinas" class="btn btn-sm btn-outline-purple text-decoration-none">
                            Ver Todas mis Rutinas
                        </a>
                    </div>

                    <div class="p-3 rounded-3 mb-3" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <h5 class="fw-bold text-dark mb-0">Hipertrofia Pecho & Tríceps</h5>
                            <span class="badge bg-purple text-white px-2.5 py-1 rounded-pill" style="background-color: #8B3DFF; font-size: 0.75rem;">DÍA 2 DE 4</span>
                        </div>
                        <p class="text-muted small mb-3">4 Ejercicios de alta intensidad diseñados por tu Coach Marcus Vance.</p>
                        
                        <div class="d-flex align-items-center justify-content-between small text-muted mb-1">
                            <span>Progreso de la sesión:</span>
                            <span class="fw-bold text-purple" style="color: #8B3DFF;">75% Completado</span>
                        </div>
                        <div class="progress" style="height: 8px; background-color: #e2e8f0;">
                            <div class="progress-bar" style="width: 75%; background-color: #8B3DFF;"></div>
                        </div>
                    </div>

                    <div class="d-flex align-items-center justify-content-between p-3 rounded-3" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-success-subtle text-success d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                <i class="bi bi-calendar-event fs-5"></i>
                            </div>
                            <div>
                                <strong class="text-dark d-block">Próxima Clase: Pilates Reformer</strong>
                                <small class="text-muted">Hoy 18:00 HS — Instructora: Elena Rostova</small>
                            </div>
                        </div>
                        <a asp-controller="Dashboard" asp-action="ClienteClases" class="btn btn-sm btn-purple fw-bold px-3">
                            Ver Clases
                        </a>
                    </div>
                </div>

                <!-- TARJETA 3: CAMBIAR CONTRASEÑA -->
                <div class="card-white">
                    <div class="card-white-header">
                        <i class="bi bi-lock-fill text-purple" style="color: #8B3DFF;"></i> Cambiar Contraseña
                    </div>

                    <form onsubmit="event.preventDefault(); alert('¡Contraseña actualizada correctamente!');">
                        <div class="mb-3">
                            <label class="form-label-light">Contraseña Actual</label>
                            <input type="password" class="form-control form-control-light" placeholder="••••••••" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label-light">Nueva Contraseña</label>
                            <input type="password" class="form-control form-control-light" placeholder="••••••••" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label-light">Confirmar Nueva Contraseña</label>
                            <input type="password" class="form-control form-control-light" placeholder="••••••••" />
                        </div>

                        <div>
                            <button type="submit" class="btn btn-outline-secondary px-4 py-2 fw-bold" style="border-radius: 10px;">
                                Actualizar Contraseña
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- PIE DE PÁGINA EGANTE -->
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between pt-4 mt-4 border-top border-slate-200 small text-muted">
            <div class="mb-2 mb-md-0">
                <strong class="text-dark">AppGimn</strong> &copy; @DateTime.Now.Year Aura Fitness SaaS. Todos los derechos reservados.
            </div>
            <div class="d-flex gap-4">
                <a href="#" class="text-muted text-decoration-none">Política de Privacidad</a>
                <a href="#" class="text-muted text-decoration-none">Términos de Servicio</a>
                <a href="#" class="text-muted text-decoration-none">Contacto</a>
            </div>
        </div>
    </div>
</div>
