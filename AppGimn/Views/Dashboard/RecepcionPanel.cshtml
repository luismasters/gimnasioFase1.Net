@model IEnumerable<AppGimn.Models.Cliente>

@{
    ViewData["Title"] = "Terminal de Marcación & Check-in - Recepción";
}

<!-- SUB-BARRA DE NAVEGACIÓN EXCLUSIVA DE TRABAJO PARA RECEPCIÓN -->
<div class="bg-dark border-bottom border-secondary py-2 mb-4">
    <div class="container-fluid px-lg-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="saas-badge saas-badge-purple" style="background-color: var(--color-info); color: #fff;">
                    <i class="bi bi-display me-1"></i> TERMINAL DE ACCESO Y CHECK-IN
                </span>
                <span class="text-white fw-bold d-none d-md-inline">AURA FITNESS CLUB - RECEPCIÓN</span>
            </div>
            <div class="nav nav-pills gap-1">
                <a asp-controller="Dashboard" asp-action="RecepcionPanel" class="nav-link active bg-purple text-white btn-sm px-3">
                    <i class="bi bi-qr-code-scan me-1"></i> Terminal Check-in
                </a>
                <a asp-controller="Dashboard" asp-action="RecepcionCobros" class="nav-link btn-secondary-saas text-white btn-sm px-3">
                    <i class="bi bi-cash-coin me-1"></i> Cobros & Caja
                </a>
                <a asp-controller="Cliente" asp-action="Index" class="nav-link btn-secondary-saas text-white btn-sm px-3">
                    <i class="bi bi-people me-1"></i> Padrón de Socios
                </a>
                <a asp-controller="Cliente" asp-action="Create" class="nav-link btn-secondary-saas text-white btn-sm px-3">
                    <i class="bi bi-person-plus me-1"></i> Registrar Socio
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid px-lg-4 pb-5">
    <!-- BARRA DE ESTADO DE OPERADOR MOSTRADOR -->
    <div class="saas-card p-3 mb-4 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3" style="background-color: #181818; border-color: var(--color-info);">
        <div class="d-flex align-items-center gap-3">
            <div class="brand-badge-purple" style="background-color: var(--color-info); width: 46px; height: 46px; font-size: 1.35rem;">
                <i class="bi bi-person-badge"></i>
            </div>
            <div>
                <h4 class="fw-bold text-white mb-0">Operador: Ana Martínez (Turno Mañana)</h4>
                <p class="text-secondary small mb-0">Terminal de Control de Acceso y Molinetes en Tiempo Real</p>
            </div>
        </div>
        <div>
            <span class="badge bg-success fs-6 py-2 px-3">
                <i class="bi bi-wifi me-1"></i> MOLINETE DE INGRESO ONLINE
            </span>
        </div>
    </div>

    <!-- TERMINAL DE CHECK-IN Y SEMÁFORO DE ACCESO CENTRALIZADO (100% ENFOCADO EN ACCESO) -->
    <div class="row g-4 mb-4 justify-content-center">
        <div class="col-lg-10">
            <div class="saas-card p-4 p-md-5" style="border-top: 6px solid var(--primary);">
                <div class="text-center mb-4">
                    <h2 class="fw-bold text-white mb-2">
                        <i class="bi bi-qr-code-scan text-primary me-2"></i>Escáner / Marcación de Ingreso por DNI
                    </h2>
                    <p class="text-secondary">Ingresa el DNI del socio o utiliza el lector de código de barras / carnet QR:</p>
                </div>

                <!-- INPUT PRINCIPAL DE DNI -->
                <div class="input-group input-group-lg mb-4" style="max-width: 700px; margin: 0 auto;">
                    <span class="input-group-text bg-dark border-secondary text-muted fs-3 px-4">
                        <i class="bi bi-person-vcard"></i>
                    </span>
                    <input type="text" class="form-control bg-dark border-secondary text-white fw-bold fs-2 text-center" 
                           placeholder="Ingresar DNI socio..." id="dniInputTerminal" value="11223344" autofocus />
                    <button class="btn btn-purple px-4 px-md-5 fw-bold fs-5" type="button" id="btnValidarIngreso">
                        <i class="bi bi-box-arrow-in-right me-2"></i> INGRESO
                    </button>
                </div>

                <!-- PRUEBAS RÁPIDAS EN VIVO PARA MOSTRAR -->
                <div class="d-flex flex-wrap justify-content-center gap-2 mb-4">
                    <span class="text-muted small fw-bold align-self-center me-2">Pruebas rápidas:</span>
                    <button class="btn btn-outline-success btn-sm" onclick="ejecutarValidacionDni('11223344')">
                        🟢 DNI 11223344 (Carlos Gómez - Al Día)
                    </button>
                    <button class="btn btn-outline-danger btn-sm" onclick="ejecutarValidacionDni('22334455')">
                        🔴 DNI 22334455 (María López - Vencida)
                    </button>
                    <button class="btn btn-outline-warning btn-sm" onclick="ejecutarValidacionDni('99999999')">
                        ⚪ DNI 99999999 (No Registrado)
                    </button>
                </div>

                <!-- BANNER DINÁMICO DE SEMÁFORO DE ACCESO -->
                <div id="semaforoAccesoBox" class="saas-card p-4 rounded-3 text-center" style="background-color: rgba(34, 197, 94, 0.15); border: 3px solid var(--color-success); max-width: 800px; margin: 0 auto;">
                    <div class="d-flex align-items-center justify-content-center gap-3 mb-2">
                        <div id="semaforoIcon" class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center fw-bold fs-1" style="width: 70px; height: 70px;">
                            ✓
                        </div>
                        <div class="text-start">
                            <h3 id="semaforoStatusTitle" class="fw-bold text-success mb-0">🟢 ACCESO AUTORIZADO - PASO LIBRE</h3>
                            <div id="semaforoSocioInfo" class="text-white fw-bold fs-4">Socio: Carlos Gómez (DNI: 11223344)</div>
                            <div id="semaforoDetalle" class="small text-secondary">Membresía: Pase Premium 24/7 | Vencimiento: 28/08/2024 | Apto Médico: Vigente</div>
                        </div>
                    </div>

                    <!-- BOTÓN ACCIÓN CUANDO ESTÁ VENCIDO O NO REGISTRADO -->
                    <div id="accionDirectaBox" class="mt-3 d-none">
                        <a id="btnIrACobrar" href="/Dashboard/RecepcionCobros?busquedaDni=22334455" class="btn btn-purple btn-lg px-4 fw-bold">
                            <i class="bi bi-cash-coin me-2"></i> IR A COBRAR CUOTA EN SECCIÓN COBROS
                        </a>
                        <a id="btnIrARegistrar" href="/Cliente/Create" class="btn btn-outline-light btn-lg px-4 fw-bold ms-2 d-none">
                            <i class="bi bi-person-plus me-2"></i> REGISTRAR COMO NUEVO SOCIO
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- TABLA DE DE SOCIOS PRESENTES EN EL GIMNASIO AHORA -->
    <div class="row g-4">
        <div class="col-lg-12">
            <div class="saas-card overflow-hidden">
                <div class="p-3 bg-dark border-bottom border-secondary d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold text-white mb-0">
                        <i class="bi bi-people-fill text-primary me-2"></i>Socios Presentes en las Instalaciones (@Model.Count())
                    </h5>
                    <span class="badge bg-secondary">Capacidad Salón: @Model.Count() / 100 socios</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-saas mb-0 align-middle">
                        <thead>
                            <tr>
                                <th>Socio / DNI</th>
                                <th>Email</th>
                                <th>Teléfono</th>
                                <th>Contacto Emergencia</th>
                                <th>Estado Cuota</th>
                                <th class="text-end">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cliente in Model)
                            {
                                <tr>
                                    <td class="fw-bold text-white">
                                        <i class="bi bi-person-circle me-2 text-primary"></i>@cliente.NombreCompleto
                                        <small class="d-block text-muted">DNI: @cliente.DNI</small>
                                    </td>
                                    <td>@(cliente.Email ?? "-")</td>
                                    <td>@(cliente.Telefono ?? "-")</td>
                                    <td class="small text-muted">@(cliente.ContactoEmergencia ?? "-")</td>
                                    <td>
                                        <span class="saas-badge saas-badge-success">
                                            <i class="bi bi-check-circle-fill me-1"></i> Al Día
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-secondary-saas btn-sm py-1" onclick="alert('Salida registrada para @cliente.NombreCompleto')">
                                            <i class="bi bi-box-arrow-right me-1"></i> Marcar Salida
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function ejecutarValidacionDni(dni) {
            document.getElementById('dniInputTerminal').value = dni;
            
            const box = document.getElementById('semaforoAccesoBox');
            const icon = document.getElementById('semaforoIcon');
            const title = document.getElementById('semaforoStatusTitle');
            const info = document.getElementById('semaforoSocioInfo');
            const detalle = document.getElementById('semaforoDetalle');
            const accionBox = document.getElementById('accionDirectaBox');
            const btnCobrar = document.getElementById('btnIrACobrar');
            const btnRegistrar = document.getElementById('btnIrARegistrar');

            $.post('/Dashboard/ValidarCheckinDni', { dni: dni }, function(res) {
                accionBox.classList.remove('d-none');
                btnCobrar.classList.add('d-none');
                btnRegistrar.classList.add('d-none');

                if (res.ok && res.estado === 'AL_DIA') {
                    box.style.backgroundColor = 'rgba(34, 197, 94, 0.15)';
                    box.style.borderColor = 'var(--color-success)';
                    icon.className = 'rounded-circle bg-success text-white d-flex align-items-center justify-content-center fw-bold fs-1';
                    icon.innerText = '✓';
                    title.className = 'fw-bold text-success mb-0';
                    title.innerText = '🟢 ACCESO AUTORIZADO - PASO LIBRE MOLINETE';
                    info.innerText = 'Socio: ' + res.nombre + ' (DNI: ' + res.dni + ')';
                    detalle.innerText = 'Membresía Activa | Vencimiento: ' + res.vencimiento + ' | Apto Médico: Vigente';
                    accionBox.classList.add('d-none');
                } else if (res.ok && res.estado === 'VENCIDO') {
                    box.style.backgroundColor = 'rgba(239, 68, 68, 0.15)';
                    box.style.borderColor = 'var(--color-danger)';
                    icon.className = 'rounded-circle bg-danger text-white d-flex align-items-center justify-content-center fw-bold fs-1';
                    icon.innerText = '✕';
                    title.className = 'fw-bold text-danger mb-0';
                    title.innerText = '🔴 ACCESO DENEGADO - CUOTA VENCIDA';
                    info.innerText = 'Socio: ' + res.nombre + ' (DNI: ' + res.dni + ')';
                    detalle.innerText = 'Membresía caducada el ' + res.vencimiento + '. Requiere cobro de cuota.';
                    btnCobrar.href = '/Dashboard/RecepcionCobros?busquedaDni=' + res.dni;
                    btnCobrar.classList.remove('d-none');
                } else {
                    box.style.backgroundColor = 'rgba(245, 158, 11, 0.15)';
                    box.style.borderColor = 'var(--color-warning)';
                    icon.className = 'rounded-circle bg-warning text-dark d-flex align-items-center justify-content-center fw-bold fs-1';
                    icon.innerText = '!';
                    title.className = 'fw-bold text-warning mb-0';
                    title.innerText = '⚪ SOCIO NO REGISTRADO';
                    info.innerText = 'DNI: ' + dni + ' no encontrado en el sistema';
                    detalle.innerText = 'El DNI ingresado no pertenece a ningún cliente. Debe registrarlo como nuevo socio.';
                    btnRegistrar.classList.remove('d-none');
                }
            });
        }

        document.getElementById('btnValidarIngreso').addEventListener('click', function() {
            const dni = document.getElementById('dniInputTerminal').value;
            if (dni) {
                ejecutarValidacionDni(dni);
            }
        });

        document.getElementById('dniInputTerminal').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                ejecutarValidacionDni(this.value);
            }
        });
    </script>
}
