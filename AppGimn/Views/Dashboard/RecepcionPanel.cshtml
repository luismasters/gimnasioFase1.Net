@model IEnumerable<AppGimn.Models.Cliente>

@{
    ViewData["Title"] = "Terminal de Marcación & Check-in - Recepción";
}

<div class="recepcion-layout">
    <partial name="_RecepcionSidebar" />

    <div class="recepcion-content container-fluid px-lg-4 py-4 pb-5">
    <!-- TERMINAL DE CHECK-IN Y SEMÁFORO DE ACCESO CENTRALIZADO (100% ENFOCADO EN ACCESO) -->
    <div class="row g-4 mb-4 justify-content-center">
        <div class="col-lg-10">
            <div class="saas-card p-4 p-md-5" style="border-top: 6px solid var(--primary);">
                <div class="text-center mb-4">
                    <h2 class="fw-bold text-white mb-2">
                        <i class="bi bi-qr-code-scan text-primary me-2"></i>Escáner / Marcación de Ingreso por DNI
                    </h2>
                    <p class="text-secondary">Ingresa el DNI del socio o utiliza el lector de código de barras / carnet QR:</p>
                </div>

                <!-- INPUT PRINCIPAL DE DNI -->
                <div class="mb-4" style="max-width: 640px; margin: 0 auto;">
                    <label for="dniInputTerminal" class="text-muted small fw-bold text-uppercase d-block mb-2">Ingresar número de DNI</label>
                    <div class="d-flex gap-2">
                        <input type="text" class="form-control form-control-lg bg-dark border-secondary text-white fw-bold fs-2 text-center"
                               id="dniInputTerminal" value="11223344" autofocus />
                        <button class="btn btn-purple px-5 fw-bold fs-5 text-nowrap" type="button" id="btnValidarIngreso">
                            <i class="bi bi-box-arrow-in-right me-2"></i> INGRESO
                        </button>
                    </div>
                </div>

                <!-- PRUEBAS RÁPIDAS EN VIVO PARA MOSTRAR (eliminadas en versión final) -->

                <!-- BANNER DINÁMICO DE SEMÁFORO DE ACCESO -->
                <div id="semaforoAccesoBox" class="saas-card p-4 rounded-4 d-none" style="background-color: rgba(34, 197, 94, 0.15); border: 3px solid var(--color-success); max-width: 820px; margin: 0 auto;">
                    <div class="d-flex align-items-center gap-4 text-start">
                        <!-- FOTO GRANDE DEL SOCIO CON ESQUINAS REDONDEADAS -->
                        <div id="semaforoFoto" class="d-flex align-items-center justify-content-center flex-shrink-0 border border-3 border-success" style="width: 120px; height: 140px; border-radius: 18px; overflow: hidden; background-color: var(--bg-surface-variant);">
                            <i class="bi bi-person-fill text-muted" style="font-size: 3.2rem;"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <div id="semaforoIcon" class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center fw-bold flex-shrink-0" style="width: 34px; height: 34px; font-size: 1.1rem;">
                                    ✓
                                </div>
                                <h3 id="semaforoStatusTitle" class="fw-bold text-success mb-0">ACCESO AUTORIZADO</h3>
                            </div>
                            <div id="semaforoSocioInfo" class="text-white fw-bold fs-3">Carlos Gómez</div>
                            <div class="d-flex flex-wrap gap-2 mt-3">
                                <span class="saas-badge saas-badge-purple">
                                    <i class="bi bi-patch-check-fill me-1"></i>Membresía: <strong id="semaforoMembresia">Pase Premium 24/7</strong>
                                </span>
                                <span class="saas-badge saas-badge-success">
                                    <i class="bi bi-calendar-check me-1"></i>Vence: <strong id="semaforoVencimiento">28/08/2024</strong>
                                </span>
                            </div>
                            <div id="semaforoDetalle" class="small text-secondary mt-2">Apto Médico: Vigente</div>
                        </div>
                    </div>

                    <!-- BOTÓN ACCIÓN CUANDO ESTÁ VENCIDO O NO REGISTRADO -->
                    <div id="accionDirectaBox" class="mt-3 d-none">
                        <a id="btnIrACobrar" href="/Dashboard/RecepcionCobros?busquedaDni=22334455" class="btn btn-purple btn-lg px-4 fw-bold">
                            <i class="bi bi-cash-coin me-2"></i> IR A COBRAR CUOTA EN SECCIÓN COBROS
                        </a>
                        <a id="btnIrARegistrar" href="/Cliente/Create" class="btn btn-outline-light btn-lg px-4 fw-bold ms-2 d-none">
                            <i class="bi bi-person-plus me-2"></i> REGISTRAR COMO NUEVO SOCIO
                        </a>
                    </div>

                    <!-- BOTÓN OK PARA LIMPIAR Y OCULTAR LA FICHA -->
                    <div class="d-flex justify-content-end mt-4 pt-3 border-top border-secondary d-none" id="btnLimpiarFichaWrapper">
                        <button type="button" id="btnLimpiarFicha" class="btn btn-dark border-secondary px-4 fw-bold">
                            <i class="bi bi-check2-circle me-1 text-success"></i> OK
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- TABLA DE DE SOCIOS PRESENTES EN EL GIMNASIO AHORA -->
    <div class="row g-4">
        <div class="col-lg-12">
            <div class="saas-card overflow-hidden">
                <div class="p-3 bg-dark border-bottom border-secondary d-flex justify-content-between align-items-center cursor-pointer" data-bs-toggle="collapse" data-bs-target="#collapseSociosPresentes" style="cursor: pointer;">
                    <h5 class="fw-bold text-white mb-0">
                        <i class="bi bi-people-fill text-primary me-2"></i>Socios Presentes en las Instalaciones (@Model.Count())
                        <i id="chevronSocios" class="bi bi-chevron-up ms-2 text-muted small"></i>
                    </h5>
                    <span class="badge bg-secondary">Capacidad Salón: @Model.Count() / 100 socios</span>
                </div>
                <div id="collapseSociosPresentes" class="collapse show">
                    <div class="table-responsive">
                    <table class="table table-saas mb-0 align-middle">
                        <thead>
                            <tr>
                                <th>Socio / DNI</th>
                                <th>Email</th>
                                <th>Teléfono</th>
                                <th>Contacto Emergencia</th>
                                <th>Estado Cuota</th>
                                <th class="text-end">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cliente in Model)
                            {
                                <tr>
                                    <td class="fw-bold text-white">
                                        <div class="d-flex align-items-center gap-2">
                                            @{ ViewBag.AvatarSize = 38; }
                                            <partial name="_ClienteAvatar" model="cliente" />
                                            <div>
                                                @cliente.NombreCompleto
                                                <small class="d-block text-muted fw-normal">DNI: @cliente.DNI</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@(cliente.Email ?? "-")</td>
                                    <td>@(cliente.Telefono ?? "-")</td>
                                    <td class="small text-muted">@(cliente.ContactoEmergencia ?? "-")</td>
                                    <td>
                                        <span class="saas-badge saas-badge-success">
                                            <i class="bi bi-check-circle-fill me-1"></i> Al Día
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-secondary-saas btn-sm py-1" onclick="alert('Salida registrada para @cliente.NombreCompleto')">
                                            <i class="bi bi-box-arrow-right me-1"></i> Marcar Salida
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                </div>
            </div>
        </div>
    </div>
    </div>
</div>

@section Scripts {
    <script>
        function ejecutarValidacionDni(dni) {
            document.getElementById('dniInputTerminal').value = dni;
            
            const box = document.getElementById('semaforoAccesoBox');
            const icon = document.getElementById('semaforoIcon');
            const foto = document.getElementById('semaforoFoto');
            const title = document.getElementById('semaforoStatusTitle');
            const info = document.getElementById('semaforoSocioInfo');
            const membresia = document.getElementById('semaforoMembresia');
            const vencimiento = document.getElementById('semaforoVencimiento');
            const detalle = document.getElementById('semaforoDetalle');
            const accionBox = document.getElementById('accionDirectaBox');
            const btnCobrar = document.getElementById('btnIrACobrar');
            const btnRegistrar = document.getElementById('btnIrARegistrar');
            const okWrapper = document.getElementById('btnLimpiarFichaWrapper');

            $.post('/Dashboard/ValidarCheckinDni', { dni: dni }, function(res) {
                box.classList.remove('d-none');
                okWrapper.classList.remove('d-none');
                accionBox.classList.remove('d-none');
                btnCobrar.classList.add('d-none');
                btnRegistrar.classList.add('d-none');

                foto.innerHTML = res.foto
                    ? '<img src="' + res.foto + '" class="w-100 h-100 object-fit-cover" alt="Foto del socio" />'
                    : '<i class="bi bi-person-fill text-muted" style="font-size: 3rem;"></i>';

                if (res.ok && res.estado === 'AL_DIA') {
                    box.style.backgroundColor = 'rgba(34, 197, 94, 0.15)';
                    box.style.borderColor = 'var(--color-success)';
                    foto.style.borderColor = 'var(--color-success)';
                    icon.className = 'rounded-circle bg-success text-white d-flex align-items-center justify-content-center fw-bold flex-shrink-0';
                    icon.style.cssText = 'width: 34px; height: 34px; font-size: 1.1rem;';
                    icon.innerText = '✓';
                    title.className = 'fw-bold text-success mb-0';
                    title.innerText = 'ACCESO AUTORIZADO';
                    info.innerText = res.nombre;
                    membresia.innerText = res.membresia || 'Sin membresía';
                    vencimiento.innerText = res.vencimiento || '-';
                    detalle.innerText = 'Apto Médico: Vigente';
                    accionBox.classList.add('d-none');
                } else if (res.ok && res.estado === 'VENCIDO') {
                    box.style.backgroundColor = 'rgba(239, 68, 68, 0.15)';
                    box.style.borderColor = 'var(--color-danger)';
                    foto.style.borderColor = 'var(--color-danger)';
                    icon.className = 'rounded-circle bg-danger text-white d-flex align-items-center justify-content-center fw-bold flex-shrink-0';
                    icon.style.cssText = 'width: 34px; height: 34px; font-size: 1.1rem;';
                    icon.innerText = '✕';
                    title.className = 'fw-bold text-danger mb-0';
                    title.innerText = 'ACCESO DENEGADO - CUOTA VENCIDA';
                    info.innerText = res.nombre;
                    membresia.innerText = res.membresia || 'Sin membresía';
                    vencimiento.innerText = res.vencimiento || '-';
                    detalle.innerText = 'Requiere cobro de cuota para renovar la membresía.';
                    btnCobrar.href = '/Dashboard/RecepcionCobros?busquedaDni=' + res.dni;
                    btnCobrar.classList.remove('d-none');
                } else {
                    box.style.backgroundColor = 'rgba(245, 158, 11, 0.15)';
                    box.style.borderColor = 'var(--color-warning)';
                    foto.style.borderColor = 'var(--color-warning)';
                    icon.className = 'rounded-circle bg-warning text-dark d-flex align-items-center justify-content-center fw-bold flex-shrink-0';
                    icon.style.cssText = 'width: 34px; height: 34px; font-size: 1.1rem;';
                    icon.innerText = '!';
                    title.className = 'fw-bold text-warning mb-0';
                    title.innerText = 'SOCIO NO REGISTRADO';
                    info.innerText = 'DNI ' + dni;
                    membresia.innerText = 'Sin membresía';
                    vencimiento.innerText = '-';
                    detalle.innerText = 'El DNI ingresado no pertenece a ningún cliente. Debe registrarlo como nuevo socio.';
                    btnRegistrar.classList.remove('d-none');
                }
            });
        }

        document.getElementById('btnValidarIngreso').addEventListener('click', function() {
            const dni = document.getElementById('dniInputTerminal').value;
            if (dni) {
                ejecutarValidacionDni(dni);
            }
        });

        document.getElementById('dniInputTerminal').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                ejecutarValidacionDni(this.value);
            }
        });

        // Botón OK: limpia y oculta la ficha de socio
        document.getElementById('btnLimpiarFicha').addEventListener('click', function() {
            document.getElementById('semaforoAccesoBox').classList.add('d-none');
            document.getElementById('btnLimpiarFichaWrapper').classList.add('d-none');
            document.getElementById('dniInputTerminal').value = '';
            document.getElementById('dniInputTerminal').focus();
        });

        // Cambia el chevron al abrir/cerrar la tabla de presentes
        document.getElementById('collapseSociosPresentes').addEventListener('hidden.bs.collapse', function() {
            document.getElementById('chevronSocios').className = 'bi bi-chevron-down ms-2 text-muted small';
        });
        document.getElementById('collapseSociosPresentes').addEventListener('shown.bs.collapse', function() {
            document.getElementById('chevronSocios').className = 'bi bi-chevron-up ms-2 text-muted small';
        });
    </script>
}
