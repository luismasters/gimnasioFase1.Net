@model IEnumerable<AppGimn.Models.Cliente>

@{
    ViewData["Title"] = "Terminal de Recepción & Mostrador - AppGimn";
}

<!-- SUB-BARRA DE NAVEGACIÓN EXCLUSIVA DE TRABAJO PARA RECEPCIÓN -->
<div class="bg-dark border-bottom border-secondary py-2 mb-4">
    <div class="container-fluid px-lg-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="saas-badge saas-badge-purple" style="background-color: var(--color-info); color: #fff;">
                    <i class="bi bi-display me-1"></i> MODO MOSTRADOR OPERATIVO
                </span>
                <span class="text-white fw-bold d-none d-md-inline">AURA FITNESS CLUB - RECEPCIÓN</span>
            </div>
            <div class="nav nav-pills gap-1">
                <a asp-controller="Dashboard" asp-action="RecepcionPanel" class="nav-link active bg-purple text-white btn-sm px-3">
                    <i class="bi bi-qr-code-scan me-1"></i> Terminal Check-in
                </a>
                <a asp-controller="Dashboard" asp-action="RecepcionCobros" class="nav-link btn-secondary-saas text-white btn-sm px-3">
                    <i class="bi bi-cash-coin me-1"></i> Cobros & Caja ($145.000)
                </a>
                <a asp-controller="Cliente" asp-action="Index" class="nav-link btn-secondary-saas text-white btn-sm px-3">
                    <i class="bi bi-people me-1"></i> Padrón de Socios
                </a>
                <a asp-controller="Cliente" asp-action="Create" class="nav-link btn-secondary-saas text-white btn-sm px-3">
                    <i class="bi bi-person-plus me-1"></i> Registrar Socio
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid px-lg-4 pb-5">
    <!-- BARRA DE ESTADO DE CAJA Y OPERADOR MOSTRADOR -->
    <div class="saas-card p-3 mb-4 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3" style="background-color: #181818; border-color: var(--color-info);">
        <div class="d-flex align-items-center gap-3">
            <div class="brand-badge-purple" style="background-color: var(--color-info); width: 46px; height: 46px; font-size: 1.35rem;">
                <i class="bi bi-person-badge"></i>
            </div>
            <div>
                <h4 class="fw-bold text-white mb-0">Operador: Ana Martínez (Turno Mañana)</h4>
                <p class="text-secondary small mb-0">Caja Abierta: 08:00 hs | Arqueo Inicial: $ 20.000 | Recaudación Hoy: <strong class="text-success">$ 145.000</strong></p>
            </div>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-secondary-saas btn-sm" onclick="alert('Abriendo arqueo de caja parcial...')">
                <i class="bi bi-calculator me-1"></i> Arqueo de Caja
            </button>
            <button class="btn btn-purple btn-sm" onclick="alert('Generando reporte de cierre de turno...')">
                <i class="bi bi-lock-fill me-1"></i> Cierre de Turno
            </button>
        </div>
    </div>

    <!-- TERMINAL DE CHECK-IN Y SEMÁFORO DE ACCESO (MOLINETE) -->
    <div class="row g-4 mb-4">
        <!-- SIMULADOR Y PANTALLA DE MARCACIÓN DE DNI -->
        <div class="col-lg-7">
            <div class="saas-card p-4 h-100" style="border-left: 5px solid var(--primary);">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h4 class="fw-bold text-white mb-0">
                        <i class="bi bi-qr-code-scan text-primary me-2"></i>Terminal de Ingreso por DNI / Escáner
                    </h4>
                    <span class="badge bg-success">
                        <i class="bi bi-wifi"></i> MOLINETE ONLINE
                    </span>
                </div>

                <p class="text-secondary small mb-3">Ingresa el DNI del socio o haz clic en las pruebas relámpago de mostrador:</p>

                <!-- INPUT PRINCIPAL DE DNI -->
                <div class="input-group input-group-lg mb-3">
                    <span class="input-group-text bg-dark border-secondary text-muted fs-4">
                        <i class="bi bi-person-vcard"></i>
                    </span>
                    <input type="text" class="form-control bg-dark border-secondary text-white fw-bold fs-4" 
                           placeholder="Ingresar DNI socio..." id="dniInputTerminal" value="11223344" />
                    <button class="btn btn-purple px-4 fw-bold" type="button" id="btnSimularCheckin">
                        <i class="bi bi-box-arrow-in-right me-1"></i> VALIDAR ACCESO
                    </button>
                </div>

                <!-- PRUEBAS RELÁMPAGO RÁPIDAS PARA MOSTRAR AL USUARIO -->
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <span class="text-muted small fw-bold align-self-center me-1">Probar DNI:</span>
                    <button class="btn btn-outline-success btn-sm" onclick="probarDni('11223344', 'Carlos Gómez', 'AL_DIA')">
                        🟢 11223344 (Carlos Gómez - Al día)
                    </button>
                    <button class="btn btn-outline-danger btn-sm" onclick="probarDni('22334455', 'María López', 'VENCIDO')">
                        🔴 22334455 (María López - Vencido)
                    </button>
                    <button class="btn btn-outline-warning btn-sm" onclick="probarDni('33445566', 'Juan Pérez', 'OBSERVACION')">
                        🟡 33445566 (Juan Pérez - Alerta Salud)
                    </button>
                </div>

                <!-- BANNER DINÁMICO DE SEMÁFORO DE ACCESO -->
                <div id="semaforoAccesoBox" class="saas-card p-3 rounded-3" style="background-color: rgba(34, 197, 94, 0.15); border: 2px solid var(--color-success);">
                    <div class="d-flex align-items-center gap-3">
                        <div id="semaforoIcon" class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center fw-bold fs-2" style="width: 58px; height: 58px;">
                            ✓
                        </div>
                        <div class="flex-grow-1">
                            <h4 id="semaforoStatusTitle" class="fw-bold text-success mb-0">🟢 ACCESO AUTORIZADO - PASO LIBRE</h4>
                            <div id="semaforoSocioInfo" class="text-white fw-bold fs-5">Socio: Carlos Gómez (DNI: 11223344)</div>
                            <div id="semaforoDetalle" class="small text-secondary">Membresía: Pase Premium 24/7 | Vencimiento: 28/08/2024 | Apto Médico: Vigente</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- MÓDULO DE COBRO EXPRESS DE MES DE GIMNASIO -->
        <div class="col-lg-5">
            <div class="saas-card p-4 h-100 d-flex flex-column justify-content-between" style="border-left: 5px solid var(--color-warning);">
                <div>
                    <h4 class="fw-bold text-white mb-3">
                        <i class="bi bi-credit-card-2-front text-warning me-2"></i>Cobro Express en Mostrador
                    </h4>
                    
                    <div class="mb-3">
                        <label class="form-label text-white small fw-bold">SOCIO A COBRAR</label>
                        <select class="form-select bg-dark text-white border-secondary" id="selectSocioCobro">
                            <option value="22334455">María López (DNI 22334455) - VENCIDO $75.000</option>
                            <option value="11223344">Carlos Gómez (DNI 11223344) - Al Día</option>
                            <option value="33445566">Juan Pérez (DNI 33445566) - Renueva el 10/08</option>
                        </select>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label text-white small fw-bold">PLAN DE MEMBRESÍA</label>
                            <select class="form-select bg-dark text-white border-secondary">
                                <option>Pase Premium ($75.000)</option>
                                <option>Pase Estándar ($45.000)</option>
                                <option>Pase VIP ($120.000)</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label text-white small fw-bold">MEDIO DE PAGO</label>
                            <select class="form-select bg-dark text-white border-secondary">
                                <option>Efectivo</option>
                                <option>Mercado Pago / QRs</option>
                                <option>Tarjeta de Débito</option>
                                <option>Tarjeta de Crédito</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div>
                    <div class="p-3 bg-dark rounded border border-secondary mb-3 d-flex align-items-center justify-content-between">
                        <span class="text-muted small fw-bold">TOTAL A COBRAR:</span>
                        <span class="fs-3 fw-bold text-success">$ 75.000</span>
                    </div>
                    <button class="btn btn-purple btn-lg w-100 py-3 fw-bold" onclick="alert('¡Pago de $75.000 registrado con éxito para María López! Comprobante emitido y membresía renovada hasta el 30/09.')">
                        <i class="bi bi-receipt me-1"></i> PROCESAR PAGO & EMITIR COMPROBANTE
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- TABLA DE ALTA DENSIDAD: SOCIOS PRESENTES EN EL GIMNASIO AHORA -->
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="saas-card overflow-hidden">
                <div class="p-3 bg-dark border-bottom border-secondary d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold text-white mb-0">
                        <i class="bi bi-people-fill text-primary me-2"></i>Socios Presentes en el Gimnasio Ahora mismo (@Model.Count())
                    </h5>
                    <span class="badge bg-secondary">Capacidad Salón: 14 / 80 socios</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-saas mb-0 align-middle">
                        <thead>
                            <tr>
                                <th>Socio / DNI</th>
                                <th>Ingreso</th>
                                <th>Membresía</th>
                                <th>Contacto Emergencia</th>
                                <th>Estado Cuota</th>
                                <th class="text-end">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cliente in Model)
                            {
                                <tr>
                                    <td class="fw-bold text-white">
                                        <div><i class="bi bi-person-circle me-1 text-muted"></i>@cliente.NombreCompleto</div>
                                        <small class="text-muted">DNI: @cliente.DNI</small>
                                    </td>
                                    <td><span class="badge bg-dark border text-light">18:15 hs</span></td>
                                    <td>Pase Premium Aura</td>
                                    <td class="small text-muted">@(cliente.ContactoEmergencia ?? "-")</td>
                                    <td>
                                        <span class="saas-badge saas-badge-success">
                                            <i class="bi bi-check-circle-fill"></i> Al Día
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-secondary-saas btn-sm py-1" onclick="alert('Salida registrada para @cliente.NombreCompleto')">
                                            Marcar Salida
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="saas-card p-4">
                <h5 class="fw-bold text-white mb-3">
                    <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>Vencimientos & Aptos Médicos
                </h5>
                <div class="d-flex flex-column gap-3">
                    <div class="saas-card p-3" style="background-color: var(--bg-surface-variant); border-left: 4px solid var(--color-danger);">
                        <div class="d-flex justify-content-between mb-1">
                            <strong class="text-white">María López</strong>
                            <span class="badge bg-danger">Vencido</span>
                        </div>
                        <div class="small text-muted mb-2">Cuota vencida el 01/08 - Tel: 1199887766</div>
                        <button class="btn btn-purple btn-sm w-100" onclick="probarDni('22334455', 'María López', 'VENCIDO')">
                            Cobrar en Mostrador
                        </button>
                    </div>

                    <div class="saas-card p-3" style="background-color: var(--bg-surface-variant); border-left: 4px solid var(--color-warning);">
                        <div class="d-flex justify-content-between mb-1">
                            <strong class="text-white">Juan Pérez</strong>
                            <span class="badge bg-warning text-dark">Apto Médico Vence</span>
                        </div>
                        <div class="small text-muted mb-1">Requiere actualización de certificado médico.</div>
                        <small class="text-info fw-bold">Tel: 1122334455</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function probarDni(dni, nombre, estado) {
            document.getElementById('dniInputTerminal').value = dni;
            const box = document.getElementById('semaforoAccesoBox');
            const icon = document.getElementById('semaforoIcon');
            const title = document.getElementById('semaforoStatusTitle');
            const info = document.getElementById('semaforoSocioInfo');
            const detalle = document.getElementById('semaforoDetalle');

            if (estado === 'AL_DIA') {
                box.style.backgroundColor = 'rgba(34, 197, 94, 0.15)';
                box.style.borderColor = 'var(--color-success)';
                icon.className = 'rounded-circle bg-success text-white d-flex align-items-center justify-content-center fw-bold fs-2';
                icon.innerText = '✓';
                title.className = 'fw-bold text-success mb-0';
                title.innerText = '🟢 ACCESO AUTORIZADO - PASO LIBRE MOLINETE';
                info.innerText = 'Socio: ' + nombre + ' (DNI: ' + dni + ')';
                detalle.innerText = 'Membresía: Pase Premium 24/7 | Vencimiento: 28/08/2024 | Apto Médico: Vigente';
            } else if (estado === 'VENCIDO') {
                box.style.backgroundColor = 'rgba(239, 68, 68, 0.15)';
                box.style.borderColor = 'var(--color-danger)';
                icon.className = 'rounded-circle bg-danger text-white d-flex align-items-center justify-content-center fw-bold fs-2';
                icon.innerText = '✕';
                title.className = 'fw-bold text-danger mb-0';
                title.innerText = '🔴 ACCESO DENEGADO - CUOTA VENCIDA';
                info.innerText = 'Socio: ' + nombre + ' (DNI: ' + dni + ')';
                detalle.innerText = 'Deuda acumulada: $ 75.000 | Vencimiento caducado el 01/08. Requiere cobro en mostrador.';
            } else if (estado === 'OBSERVACION') {
                box.style.backgroundColor = 'rgba(245, 158, 11, 0.15)';
                box.style.borderColor = 'var(--color-warning)';
                icon.className = 'rounded-circle bg-warning text-dark d-flex align-items-center justify-content-center fw-bold fs-2';
                icon.innerText = '!';
                title.className = 'fw-bold text-warning mb-0';
                title.innerText = '🟡 INGRESO CON OBSERVACIÓN MÉDICA';
                info.innerText = 'Socio: ' + nombre + ' (DNI: ' + dni + ')';
                detalle.innerText = 'Atención: Hipertensión leve registrada. Apto médico requiere renovación en 5 días.';
            }
        }

        document.getElementById('btnSimularCheckin').addEventListener('click', function() {
            const dni = document.getElementById('dniInputTerminal').value;
            if (dni === '22334455') {
                probarDni('22334455', 'María López', 'VENCIDO');
            } else if (dni === '33445566') {
                probarDni('33445566', 'Juan Pérez', 'OBSERVACION');
            } else {
                probarDni(dni, 'Carlos Gómez', 'AL_DIA');
            }
        });
    </script>
}
