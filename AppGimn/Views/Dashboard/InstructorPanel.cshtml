@model IEnumerable<AppGimn.Models.Cliente>

@{
    ViewData["Title"] = "Panel del Entrenador - AppGimn Premium";
}

<div class="container py-4">
    <!-- ENCABEZADO DEL INSTRUCTOR -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4 gap-3">
        <div>
            <span class="saas-badge saas-badge-purple mb-2">
                <i class="bi bi-person-workspace me-1"></i> PANEL DEL INSTRUCTOR & COACH
            </span>
            <h2 class="fw-bold text-white mb-1">
                <i class="bi bi-activity text-success me-2"></i>Gestión de Entrenamiento & Alumnos
            </h2>
            <p class="text-secondary small mb-0">Asignación de rutinas, seguimiento de evolución y agenda de clases grupales</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-purple py-2 px-3 fw-bold" data-bs-toggle="modal" data-bs-target="#crearRutinaModal">
                <i class="bi bi-plus-circle-fill me-1"></i> Diseñar Nueva Rutina
            </button>
        </div>
    </div>

    <!-- RESUMEN DE AGENDA Y EVALUACIONES PENDIENTES -->
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="saas-card p-4 h-100">
                <h5 class="fw-bold text-white mb-3">
                    <i class="bi bi-calendar-event text-warning me-2"></i>Agenda de Clases de Hoy
                </h5>
                <div class="d-flex flex-column gap-2">
                    <div class="saas-card p-3 d-flex align-items-center justify-content-between" style="background-color: var(--bg-surface-variant);">
                        <div>
                            <strong class="text-white">17:30 hs — Musculación & Biomecánica</strong>
                            <div class="small text-muted"><i class="bi bi-geo-alt me-1"></i>Sala Principal A — 14 alumnos anotados</div>
                        </div>
                        <span class="badge bg-success px-2 py-1">En curso</span>
                    </div>
                    <div class="saas-card p-3 d-flex align-items-center justify-content-between" style="background-color: var(--bg-surface-variant);">
                        <div>
                            <strong class="text-white">19:00 hs — HIIT & Entrenamiento Funcional</strong>
                            <div class="small text-muted"><i class="bi bi-geo-alt me-1"></i>Estudio 2 — 18 alumnos anotados</div>
                        </div>
                        <span class="badge bg-secondary px-2 py-1">Próxima</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="saas-card p-4 h-100">
                <h5 class="fw-bold text-white mb-3">
                    <i class="bi bi-clipboard-pulse text-info me-2"></i>Evaluaciones Físicas Pendientes
                </h5>
                <div class="d-flex flex-column gap-2">
                    <div class="saas-card p-3 d-flex align-items-center justify-content-between" style="background-color: var(--bg-surface-variant);">
                        <div>
                            <strong class="text-white">Carlos Gómez</strong>
                            <div class="small text-muted"><i class="bi bi-clock-history me-1"></i>Control de % grasa corporal y 1RM Sentadilla</div>
                        </div>
                        <button class="btn btn-outline-purple btn-sm fw-bold" onclick="alert('Iniciando test biométrico para Carlos Gómez...')">
                            <i class="bi bi-journal-check me-1"></i> Evaluar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- SECCIÓN DE ALUMNOS ASIGNADOS -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h5 class="fw-bold text-white mb-0">
            <i class="bi bi-people-fill text-primary me-2"></i>Alumnos Asignados a tu Turno (@Model.Count())
        </h5>
    </div>

    <div class="row g-4">
        @foreach (var alumno in Model)
        {
            <div class="col-md-4">
                <div class="saas-card p-4 h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center gap-3 mb-3">
                            @{ ViewBag.AvatarSize = 52; ViewBag.AvatarClass = ""; }
                            <partial name="_ClienteAvatar" model="alumno" />
                            <div>
                                <h5 class="fw-bold text-white mb-0">@alumno.NombreCompleto</h5>
                                <span class="small text-muted">DNI: <code class="text-light">@alumno.DNI</code></span>
                            </div>
                        </div>

                        <div class="saas-card p-3 mb-3" style="background-color: var(--bg-surface-variant);">
                            <div class="small text-secondary mb-1"><strong>Plan:</strong> Hipertrofia & Fuerza B</div>
                            <div class="small text-secondary"><strong>Ficha Médica:</strong> @(string.IsNullOrWhiteSpace(alumno.ObservacionesMedicas) ? "Apto médico vigente" : alumno.ObservacionesMedicas)</div>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button class="btn btn-purple btn-sm flex-grow-1 fw-bold" onclick="abrirModificadorRutina('@alumno.NombreCompleto')">
                            <i class="bi bi-pencil-square me-1"></i> Asignar Rutina
                        </button>
                        <a asp-controller="Cliente" asp-action="Details" asp-route-id="@alumno.Id" class="btn btn-secondary-saas btn-sm" title="Ver Ficha">
                            <i class="bi bi-eye text-info"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- MODAL CREAR RUTINA -->
<div class="modal fade" id="crearRutinaModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-dark">Diseñador de Rutinas de Entrenamiento</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <label class="form-label fw-semibold text-dark">Nombre del Plan de Entrenamiento</label>
                    <input type="text" class="form-control" placeholder="Ej. Rutina Fuerza e Hipertrofia 4 días" />
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-dark">Grupo Muscular Principal</label>
                        <select class="form-select">
                            <option>Pecho & Tríceps</option>
                            <option>Espalda & Biceps</option>
                            <option>Piernas & Glúteos</option>
                            <option>Hombros & Core</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-dark">Nivel de Intensidad</label>
                        <select class="form-select">
                            <option>Principiante</option>
                            <option selected>Intermedio</option>
                            <option>Avanzado / Atleta</option>
                        </select>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold text-dark">Detalle de Ejercicios, Series y Repeticiones</label>
                    <textarea class="form-control" rows="4" placeholder="1. Press de Banca Plano: 4 series x 10 reps&#10;2. Press Inclinado Mancuernas: 3 series x 12 reps&#10;3. Fondos en Paralelas: 3 series al fallo"></textarea>
                </div>
                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-secondary rounded-3" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-purple rounded-3 fw-bold" onclick="guardarRutinaNueva()">
                        <i class="bi bi-check-circle-fill me-1"></i> Guardar Rutina
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function abrirModificadorRutina(nombreSocio) {
            alert('Abriendo editor de rutina personalizada para ' + nombreSocio);
        }

        function guardarRutinaNueva() {
            const modalEl = document.getElementById('crearRutinaModal');
            const modal = bootstrap.Modal.getInstance(modalEl);
            if (modal) modal.hide();
            alert('¡Rutina guardada y asignada exitosamente!');
        }
    </script>
}
