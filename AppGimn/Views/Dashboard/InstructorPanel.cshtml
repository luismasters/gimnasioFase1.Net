@model IEnumerable<AppGimn.Models.Cliente>

@{
    ViewData["Title"] = "Panel de Instructor & Entrenador - AppGimn";
}

<div class="container py-4">
    <!-- ENCABEZADO DEL INSTRUCTOR -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4 gap-3">
        <div>
            <span class="saas-badge saas-badge-purple mb-2">
                <i class="bi bi-person-workspace me-1"></i> TURNO TARDE & NOCHE
            </span>
            <h2 class="fw-bold text-white mb-1">
                <i class="bi bi-activity text-success me-2"></i>Panel del Entrenador: Lucas Rodríguez
            </h2>
            <p class="text-secondary small mb-0">Gestión de alumnos asignados, armado de rutinas y agenda de clases grupales</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-purple" onclick="alert('Abriendo creador de rutinas...')">
                <i class="bi bi-plus-circle me-1"></i> Crear Nueva Rutina
            </button>
        </div>
    </div>

    <!-- RESUMEN DE AGENDA Y ALUMNOS DESTACADOS -->
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="saas-card p-4 h-100">
                <h5 class="fw-bold text-white mb-3">
                    <i class="bi bi-calendar-event text-warning me-2"></i>Agenda de Clases de Hoy
                </h5>
                <div class="d-flex flex-column gap-2">
                    <div class="saas-card p-3 d-flex align-items-center justify-content-between" style="background-color: var(--bg-surface-variant);">
                        <div>
                            <strong class="text-white">17:30 hs - Musculación & Biomecánica</strong>
                            <div class="small text-muted">Sala Principal - 12 alumnos confirmados</div>
                        </div>
                        <span class="badge bg-success">En 45 min</span>
                    </div>
                    <div class="saas-card p-3 d-flex align-items-center justify-content-between" style="background-color: var(--bg-surface-variant);">
                        <div>
                            <strong class="text-white">19:00 hs - HIIT & Funcional de Alta Intensidad</strong>
                            <div class="small text-muted">Estudio 2 - 18 alumnos confirmados</div>
                        </div>
                        <span class="badge bg-secondary">Próxima</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="saas-card p-4 h-100">
                <h5 class="fw-bold text-white mb-3">
                    <i class="bi bi-clipboard-pulse text-info me-2"></i>Evaluaciones Físicas Pendientes
                </h5>
                <div class="d-flex flex-column gap-2">
                    <div class="saas-card p-3 d-flex align-items-center justify-content-between" style="background-color: var(--bg-surface-variant);">
                        <div>
                            <strong class="text-white">Carlos Gómez</strong>
                            <div class="small text-muted">Revisión de pliegues grasos y RM de Sentadilla</div>
                        </div>
                        <button class="btn btn-outline-purple btn-sm" onclick="alert('Evaluación física abierta')">Evaluar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- TARJETAS CON FOTOS/AVATARES DE ALUMNOS ASIGNADOS AL INSTRUCTOR -->
    <h5 class="fw-bold text-white mb-3">
        <i class="bi bi-people-fill text-primary me-2"></i>Mis Alumnos Asignados (@Model.Count())
    </h5>

    <div class="row g-4">
        @foreach (var alumno in Model)
        {
            <div class="col-md-4">
                <div class="saas-card p-4 h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold fs-4" style="width: 52px; height: 52px;">
                                @(alumno.Nombre.Substring(0,1))@(alumno.Apellido.Substring(0,1))
                            </div>
                            <div>
                                <h5 class="fw-bold text-white mb-0">@alumno.NombreCompleto</h5>
                                <span class="small text-muted">DNI: @alumno.DNI</span>
                            </div>
                        </div>

                        <div class="saas-card p-3 mb-3" style="background-color: var(--bg-surface-variant);">
                            <div class="small text-secondary mb-1"><strong>Rutina Actual:</strong> Hipertrofia Fuerza B</div>
                            <div class="small text-secondary"><strong>Ficha Médica:</strong> @(string.IsNullOrWhiteSpace(alumno.ObservacionesMedicas) ? "Apto presentado" : alumno.ObservacionesMedicas)</div>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button class="btn btn-purple btn-sm flex-grow-1" onclick="alert('Asignando rutina a @alumno.NombreCompleto')">
                            <i class="bi bi-pencil-square me-1"></i> Asignar Rutina
                        </button>
                        <button class="btn btn-secondary-saas btn-sm" onclick="alert('Abriendo ficha de salud de @alumno.NombreCompleto')">
                            <i class="bi bi-card-checklist"></i>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
