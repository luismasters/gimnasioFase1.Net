@model IEnumerable<AppGimn.Models.Cliente>

@{
    ViewData["Title"] = "Caja & Registro de Cobros - Recepción";
}

<!-- SUB-BARRA DE NAVEGACIÓN EXCLUSIVA DE TRABAJO PARA RECEPCIÓN -->
<div class="bg-dark border-bottom border-secondary py-2 mb-4">
    <div class="container-fluid px-lg-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="saas-badge saas-badge-purple" style="background-color: var(--color-info); color: #fff;">
                    <i class="bi bi-cash-coin me-1"></i> CONTROL DE CAJA Y COBROS
                </span>
                <span class="text-white fw-bold d-none d-md-inline">AURA FITNESS CLUB - RECEPCIÓN</span>
            </div>
            <div class="nav nav-pills gap-1">
                <a asp-controller="Dashboard" asp-action="RecepcionPanel" class="nav-link btn-secondary-saas text-white btn-sm px-3">
                    <i class="bi bi-qr-code-scan me-1"></i> Terminal Check-in
                </a>
                <a asp-controller="Dashboard" asp-action="RecepcionCobros" class="nav-link active bg-purple text-white btn-sm px-3">
                    <i class="bi bi-cash-coin me-1"></i> Cobros & Caja ($145.000)
                </a>
                <a asp-controller="Cliente" asp-action="Index" class="nav-link btn-secondary-saas text-white btn-sm px-3">
                    <i class="bi bi-people me-1"></i> Padrón de Socios
                </a>
                <a asp-controller="Cliente" asp-action="Create" class="nav-link btn-secondary-saas text-white btn-sm px-3">
                    <i class="bi bi-person-plus me-1"></i> Registrar Socio
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid px-lg-4 pb-5">
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4 gap-3">
        <div>
            <h2 class="fw-bold text-white mb-1">
                <i class="bi bi-calculator text-success me-2"></i>Arqueo de Caja & Comprobantes Emitidos Hoy
            </h2>
            <p class="text-secondary small mb-0">Resumen detallado de ingresos por cobranza en mostrador (Operador: Ana Martínez)</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-purple btn-sm" onclick="alert('Descargando planilla de arqueo diario en Excel...')">
                <i class="bi bi-file-earmark-excel me-1"></i> Exportar Arqueo Excel
            </button>
        </div>
    </div>

    <!-- CARDS DE MÉTRICAS DE CAJA -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="saas-card p-4 text-center">
                <span class="text-muted small fw-bold text-uppercase d-block mb-1">Total Recaudado Hoy</span>
                <div class="display-6 fw-bold text-success mb-1">$ 145.000</div>
                <span class="saas-badge saas-badge-success">8 Transacciones</span>
            </div>
        </div>
        <div class="col-md-3">
            <div class="saas-card p-4 text-center">
                <span class="text-muted small fw-bold text-uppercase d-block mb-1">Efectivo en Caja</span>
                <div class="display-6 fw-bold text-white mb-1">$ 45.000</div>
                <span class="text-muted small">+ $ 20.000 fondo inicial</span>
            </div>
        </div>
        <div class="col-md-3">
            <div class="saas-card p-4 text-center">
                <span class="text-muted small fw-bold text-uppercase d-block mb-1">Tarjetas Débito/Crédito</span>
                <div class="display-6 fw-bold text-info mb-1">$ 60.000</div>
                <span class="text-muted small">Terminal POSNet #1</span>
            </div>
        </div>
        <div class="col-md-3">
            <div class="saas-card p-4 text-center">
                <span class="text-muted small fw-bold text-uppercase d-block mb-1">Mercado Pago / QRs</span>
                <div class="display-6 fw-bold text-warning mb-1">$ 40.000</div>
                <span class="text-muted small">Transferencia acreditada</span>
            </div>
        </div>
    </div>

    <!-- TABLA DE COMPROBANTES DE COBRO DEL DÍA -->
    <div class="saas-card overflow-hidden">
        <div class="p-3 bg-dark border-bottom border-secondary d-flex justify-content-between align-items-center">
            <h5 class="fw-bold text-white mb-0">Detalle de Comprobantes de Cobranza del Día</h5>
            <span class="text-muted small">Turno Mañana: 08:00 - 16:00 hs</span>
        </div>
        <div class="table-responsive">
            <table class="table table-saas mb-0">
                <thead>
                    <tr>
                        <th>N° Comprobante</th>
                        <th>Hora</th>
                        <th>Socio / DNI</th>
                        <th>Concepto / Plan</th>
                        <th>Medio de Pago</th>
                        <th class="text-end">Monto</th>
                        <th class="text-end">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><code>#REC-00984</code></td>
                        <td>17:40 hs</td>
                        <td class="fw-bold text-white">Carlos Gómez (11223344)</td>
                        <td>Pase Premium Aura 24/7</td>
                        <td><span class="badge bg-success">Efectivo</span></td>
                        <td class="text-end fw-bold text-success">$ 75.000</td>
                        <td class="text-end">
                            <button class="btn btn-secondary-saas btn-sm py-1" onclick="alert('Reimprimiendo ticket #REC-00984')">Imprimir</button>
                        </td>
                    </tr>
                    <tr>
                        <td><code>#REC-00983</code></td>
                        <td>16:20 hs</td>
                        <td class="fw-bold text-white">María López (22334455)</td>
                        <td>Pase Estándar Mensual</td>
                        <td><span class="badge bg-info">Tarjeta Débito</span></td>
                        <td class="text-end fw-bold text-success">$ 45.000</td>
                        <td class="text-end">
                            <button class="btn btn-secondary-saas btn-sm py-1" onclick="alert('Reimprimiendo ticket #REC-00983')">Imprimir</button>
                        </td>
                    </tr>
                    <tr>
                        <td><code>#REC-00982</code></td>
                        <td>14:15 hs</td>
                        <td class="fw-bold text-white">Juan Pérez (33445566)</td>
                        <td>Pase Estándar Mensual</td>
                        <td><span class="badge bg-warning text-dark">Mercado Pago</span></td>
                        <td class="text-end fw-bold text-success">$ 45.000</td>
                        <td class="text-end">
                            <button class="btn btn-secondary-saas btn-sm py-1" onclick="alert('Reimprimiendo ticket #REC-00982')">Imprimir</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
