@model IEnumerable<AppGimn.Models.Pago>

@{
    ViewData["Title"] = "Caja & Registro de Cobros - Recepción";
    var membresias = ViewBag.MembresiasDisponibles as List<AppGimn.Models.Membresia> ?? new List<AppGimn.Models.Membresia>();
}

<!-- SUB-BARRA DE NAVEGACIÓN EXCLUSIVA DE TRABAJO PARA RECEPCIÓN -->
<div class="bg-dark border-bottom border-secondary py-2 mb-4">
    <div class="container-fluid px-lg-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="saas-badge saas-badge-purple" style="background-color: var(--color-info); color: #fff;">
                    <i class="bi bi-cash-coin me-1"></i> CONTROL DE CAJA Y COBROS
                </span>
                <span class="text-white fw-bold d-none d-md-inline">AURA FITNESS CLUB - RECEPCIÓN</span>
            </div>
            <div class="nav nav-pills gap-1">
                <a asp-controller="Dashboard" asp-action="RecepcionPanel" class="nav-link btn-secondary-saas text-white btn-sm px-3">
                    <i class="bi bi-qr-code-scan me-1"></i> Terminal Check-in
                </a>
                <a asp-controller="Dashboard" asp-action="RecepcionCobros" class="nav-link active bg-purple text-white btn-sm px-3">
                    <i class="bi bi-cash-coin me-1"></i> Cobros & Caja
                </a>
                <a asp-controller="Cliente" asp-action="Index" class="nav-link btn-secondary-saas text-white btn-sm px-3">
                    <i class="bi bi-people me-1"></i> Padrón de Socios
                </a>
                <a asp-controller="Cliente" asp-action="Create" class="nav-link btn-secondary-saas text-white btn-sm px-3">
                    <i class="bi bi-person-plus me-1"></i> Registrar Socio
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid px-lg-4 pb-5">
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4 gap-3">
        <div>
            <h2 class="fw-bold text-white mb-1">
                <i class="bi bi-calculator text-success me-2"></i>Arqueo de Caja & Comprobantes Registrados
            </h2>
            <p class="text-secondary small mb-0">Base de datos de cobranzas registradas en EF Core</p>
        </div>
    </div>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success bg-dark border-success text-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["MensajeExito"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- FORMULARIO REAL DE NUEVA COBRANZA EN BASE DE DATOS -->
    <div class="saas-card p-4 mb-4" style="border-left: 5px solid var(--color-success);">
        <h5 class="fw-bold text-white mb-3">
            <i class="bi bi-plus-circle-fill text-success me-2"></i>Registrar Nuevo Cobro de Cuota (Persistencia en Base de Datos)
        </h5>
        <form asp-controller="Dashboard" asp-action="ProcesarPagoCobro" method="post">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label text-white small fw-bold">ID / SOCIO</label>
                    <input type="number" name="clienteId" class="form-control bg-dark text-white border-secondary" placeholder="ID Cliente (Ej. 1)" value="1" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label text-white small fw-bold">PLAN DE MEMBRESÍA</label>
                    <select name="membresiaId" class="form-select bg-dark text-white border-secondary">
                        @foreach (var m in membresias)
                        {
                            <option value="@m.Id">@m.Nombre - @m.Precio.ToString("C")</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label text-white small fw-bold">MEDIO DE PAGO</label>
                    <select name="medioPago" class="form-select bg-dark text-white border-secondary">
                        <option value="Efectivo">Efectivo</option>
                        <option value="MercadoPago">Mercado Pago / QRs</option>
                        <option value="Debito">Tarjeta de Débito</option>
                        <option value="Credito">Tarjeta de Crédito</option>
                    </select>
                </div>
            </div>
            <div class="mt-3 text-end">
                <button type="submit" class="btn btn-purple btn-lg px-4 fw-bold">
                    <i class="bi bi-check-circle-fill me-1"></i> REGISTRAR PAGO EN BASE DE DATOS
                </button>
            </div>
        </form>
    </div>

    <!-- TABLA DE COMPROBANTES DE COBRO REGISTRADOS EN EF CORE -->
    <div class="saas-card overflow-hidden">
        <div class="p-3 bg-dark border-bottom border-secondary d-flex justify-content-between align-items-center">
            <h5 class="fw-bold text-white mb-0">Historial de Pagos y Facturación en Base de Datos (@Model.Count())</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-saas mb-0">
                <thead>
                    <tr>
                        <th>N° Comprobante</th>
                        <th>Fecha Pago</th>
                        <th>Socio</th>
                        <th>Concepto / Plan</th>
                        <th>Medio de Pago</th>
                        <th>Vencimiento Habilitado</th>
                        <th class="text-end">Monto</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var pago in Model)
                    {
                        <tr>
                            <td><code>@pago.ComprobanteNumero</code></td>
                            <td>@pago.FechaPago.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="fw-bold text-white">@(pago.Cliente?.NombreCompleto ?? "Socio registrado")</td>
                            <td>@(pago.Membresia?.Nombre ?? "Cuota Mensual")</td>
                            <td><span class="badge bg-success">@pago.MedioPago</span></td>
                            <td class="text-info fw-bold">@pago.FechaVencimiento.ToString("dd/MM/yyyy")</td>
                            <td class="text-end fw-bold text-success">@pago.Monto.ToString("C")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">Sin registros de pago guardados en la base de datos.</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
