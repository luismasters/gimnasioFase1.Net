@model IEnumerable<AppGimn.Models.Pago>

@{
    ViewData["Title"] = "Caja & Cobro de Cuotas - Recepción";
    var membresias = ViewBag.MembresiasDisponibles as List<AppGimn.Models.Membresia> ?? new List<AppGimn.Models.Membresia>();
    var sociosVencidos = ViewBag.SociosVencidos as List<AppGimn.Models.Cliente> ?? new List<AppGimn.Models.Cliente>();
    var clienteBuscado = ViewBag.ClienteBuscado as AppGimn.Models.Cliente;
    bool socioExiste = ViewBag.SocioExiste ?? true;
    string busquedaDni = ViewBag.BusquedaDni as string ?? "";
}

<div class="recepcion-layout">
    <partial name="_RecepcionSidebar" />

    <div class="recepcion-content container-fluid px-lg-4 py-4 pb-5">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4 gap-3">
        <div>
            <h2 class="fw-bold text-white mb-1">
                <i class="bi bi-credit-card-2-front text-success me-2"></i>Cobro de Cuotas & Gestión de Vencidos
            </h2>
            <p class="text-secondary small mb-0">Busca por DNI, cobra la mensualidad y activa el pase del socio instantáneamente</p>
        </div>
        <div>
            <span class="badge bg-danger fs-6 py-2 px-3">
                <i class="bi bi-exclamation-octagon-fill me-1"></i> @sociosVencidos.Count SOCIOS VENCIDOS PENDIENTES DE COBRO
            </span>
        </div>
    </div>

    <!-- MENSAJES DE ÉXITO O ERROR DE TRANSACCIÓN -->
    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success bg-dark border-success text-success alert-dismissible fade show rounded-3 mb-4 p-3 fs-6" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i> @TempData["MensajeExito"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-danger bg-dark border-danger text-danger alert-dismissible fade show rounded-3 mb-4 p-3 fs-6" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i> @TempData["MensajeError"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- BUSCADOR PRINCIPAL POR DNI DEL SOCIO -->
    <div class="saas-card p-4 mb-4" style="border-left: 5px solid var(--primary);">
        <h4 class="fw-bold text-white mb-3">
            <i class="bi bi-search text-primary me-2"></i>Buscar Socio a Cobrar por DNI
        </h4>
        
        <form asp-controller="Dashboard" asp-action="RecepcionCobros" method="get">
            <div class="input-group input-group-lg">
                <span class="input-group-text bg-dark border-secondary text-muted fs-4">
                    <i class="bi bi-person-vcard"></i>
                </span>
                <input type="text" name="busquedaDni" class="form-control bg-dark border-secondary text-white fw-bold fs-4" 
                       placeholder="Buscar por DNI del socio..." value="@busquedaDni" autofocus />
                <button class="btn btn-purple px-4 fw-bold fs-5" type="submit">
                    <i class="bi bi-search me-1"></i> BUSCAR SOCIO
                </button>
            </div>
        </form>

        <!-- ALERTA CUANDO EL DNI INGRESADO NO EXISTE EN EL SISTEMA -->
        @if (!socioExiste)
        {
            <div class="mt-4 p-3 rounded-3 bg-danger bg-opacity-10 border border-danger">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                    <div>
                        <h5 class="fw-bold text-danger mb-1">
                            <i class="bi bi-person-x-fill me-2"></i>Socio No Registrado en el Sistema
                        </h5>
                        <p class="text-secondary mb-0">El DNI <strong>@busquedaDni</strong> no pertenece a ningún cliente registrado. Para procesar el cobro, debes darlo de alta primero.</p>
                    </div>
                    <a asp-controller="Cliente" asp-action="Create" class="btn btn-purple btn-lg fw-bold">
                        <i class="bi bi-person-plus-fill me-1"></i> REGISTRAR NUEVO SOCIO
                    </a>
                </div>
            </div>
        }
    </div>

    <!-- MÓDULO DE CAJA: COBRAR AL SOCIO SELECCIONADO / BUSCADO -->
    <div class="saas-card p-4 mb-4" style="border-left: 5px solid var(--color-success);">
        <h4 class="fw-bold text-white mb-3">
            <i class="bi bi-cash-stack text-success me-2"></i>Procesar Pago & Renovación de Membresía
        </h4>

        <form asp-controller="Dashboard" asp-action="ProcesarPagoCobro" method="post">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label text-white small fw-bold">DNI DEL SOCIO A COBRAR</label>
                    <div class="d-flex align-items-center gap-2">
                        @if (clienteBuscado != null)
                        {
                            <div class="flex-shrink-0">
                                @{ ViewBag.AvatarSize = 44; }
                                <partial name="_ClienteAvatar" model="clienteBuscado" />
                            </div>
                        }
                        <input type="text" name="dniCliente" class="form-control bg-dark text-white border-secondary fw-bold fs-5" 
                               placeholder="Ingresar DNI socio..." id="inputDniCobro" value="@(clienteBuscado?.DNI ?? (sociosVencidos.FirstOrDefault()?.DNI ?? "22334455"))" required />
                    </div>
                    @if (clienteBuscado != null)
                    {
                        <small class="text-success fw-bold d-block mt-1">✓ Socio Seleccionado: @clienteBuscado.NombreCompleto</small>
                    }
                </div>

                <div class="col-md-4">
                    <label class="form-label text-white small fw-bold">PLAN DE MEMBRESÍA A ACTIVAR</label>
                    <select name="membresiaId" class="form-select bg-dark text-white border-secondary fs-5" required>
                        @foreach (var m in membresias)
                        {
                            <option value="@m.Id">@m.Nombre - @m.Precio.ToString("C") (@m.DuracionDias días)</option>
                        }
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label text-white small fw-bold">MEDIO DE PAGO</label>
                    <select name="medioPago" class="form-select bg-dark text-white border-secondary fs-5">
                        <option value="Efectivo">Efectivo en Caja</option>
                        <option value="MercadoPago">Mercado Pago / QR</option>
                        <option value="Debito">Tarjeta de Débito</option>
                        <option value="Credito">Tarjeta de Crédito</option>
                    </select>
                </div>
            </div>

            <div class="mt-4 text-end">
                <button type="submit" class="btn btn-purple btn-lg px-5 py-3 fw-bold fs-5">
                    <i class="bi bi-receipt me-2"></i> PROCESAR PAGO & ACTIVAR MEMBRESÍA
                </button>
            </div>
        </form>
    </div>

    <div class="row g-4 mb-4">
        <!-- LISTADO DE SOCIOS CON SUSCRIPCIÓN VENCIDA (VENCIDOS) -->
        <div class="col-lg-7">
            <div class="saas-card overflow-hidden h-100 border-start border-danger border-4">
                <div class="p-3 bg-dark border-bottom border-secondary d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold text-white mb-0">
                        <i class="bi bi-clock-history text-danger me-2"></i>Socios con Cuota Vencida (@sociosVencidos.Count)
                    </h5>
                    <span class="badge bg-danger">Vencidos Pendientes</span>
                </div>

                <div class="table-responsive">
                    <table class="table table-saas mb-0 align-middle">
                        <thead>
                            <tr>
                                <th>Socio / DNI</th>
                                <th>Teléfono</th>
                                <th>Estado</th>
                                <th class="text-end">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (sociosVencidos.Any())
                        {
                            foreach (var s in sociosVencidos)
                            {
                                <tr>
                                    <td class="fw-bold text-white">
                                        <div class="d-flex align-items-center gap-2">
                                            @{ ViewBag.AvatarSize = 36; }
                                            <partial name="_ClienteAvatar" model="s" />
                                            <div>
                                                @s.NombreCompleto
                                                <small class="text-muted fw-normal">DNI: @s.DNI</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="small text-muted">@(s.Telefono ?? "-")</td>
                                    <td>
                                        <span class="saas-badge saas-badge-danger">
                                            <i class="bi bi-x-circle-fill me-1"></i> Cuota Vencida
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-purple btn-sm py-1 fw-bold" onclick="seleccionarParaCobro('@s.DNI')">
                                            <i class="bi bi-cash me-1"></i> Cobrar Cuota
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-success fw-bold">
                                    <i class="bi bi-check-all me-1"></i> ¡Excelente! No hay ningún socio con cuota vencida pendiente.
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- RECAUDACIÓN Y COMPROBANTES DE HOY -->
        <div class="col-lg-5">
            <div class="saas-card overflow-hidden h-100">
                <div class="p-3 bg-dark border-bottom border-secondary d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold text-white mb-0">
                        <i class="bi bi-journal-check text-success me-2"></i>Últimos Cobros Registrados (@Model.Count())
                    </h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-saas mb-0 align-middle">
                        <thead>
                            <tr>
                                <th>N° Ticket</th>
                                <th>Socio</th>
                                <th>Medio</th>
                                <th class="text-end">Monto</th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var pago in Model.Take(6))
                            {
                                <tr>
                                    <td><code>@pago.ComprobanteNumero</code></td>
                                    <td class="fw-bold text-white small">
                                        @if (pago.Cliente != null)
                                        {
                                            <div class="d-flex align-items-center gap-2">
                                                @{ ViewBag.AvatarSize = 30; }
                                                <partial name="_ClienteAvatar" model="pago.Cliente" />
                                                @(pago.Cliente.NombreCompleto)
                                            </div>
                                        }
                                        else
                                        {
                                            @("Socio")
                                        }
                                    </td>
                                    <td><span class="badge bg-secondary small">@pago.MedioPago</span></td>
                                    <td class="text-end fw-bold text-success">@pago.Monto.ToString("C")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-3 text-muted">Sin cobros en este turno.</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    </div>
</div>

@section Scripts {
    <script>
        function seleccionarParaCobro(dni) {
            document.getElementById('inputDniCobro').value = dni;
            window.scrollTo({ top: 300, behavior: 'smooth' });
        }
    </script>
}
