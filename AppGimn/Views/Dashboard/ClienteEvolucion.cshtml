@{
    ViewData["Title"] = "Mi Evolución Física y Métricas - AppGimn";
}

<!-- SUB-BARRA DE NAVEGACIÓN EXCLUSIVA PARA EL CLIENTE -->
<div class="bg-dark border-bottom border-secondary py-2 mb-4">
    <div class="container">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="saas-badge saas-badge-purple">
                    <i class="bi bi-graph-up-arrow me-1"></i> SEGUIMIENTO CORPORAL
                </span>
                <span class="text-white fw-bold d-none d-md-inline">AURA FITNESS CLUB</span>
            </div>
            <div class="nav nav-pills gap-1">
                <a asp-controller="Dashboard" asp-action="ClientePanel" class="nav-link btn-secondary-saas text-white btn-sm px-3">
                    <i class="bi bi-house-door me-1"></i> Mi Inicio
                </a>
                <a asp-controller="Dashboard" asp-action="ClienteRutinas" class="nav-link btn-secondary-saas text-white btn-sm px-3">
                    <i class="bi bi-journal-bookmark me-1"></i> Mis Rutinas
                </a>
                <a asp-controller="Dashboard" asp-action="ClienteEvolucion" class="nav-link active bg-purple text-white btn-sm px-3">
                    <i class="bi bi-graph-up-arrow me-1"></i> Mi Evolución
                </a>
                <a asp-controller="Dashboard" asp-action="ClienteClases" class="nav-link btn-secondary-saas text-white btn-sm px-3">
                    <i class="bi bi-calendar-check me-1"></i> Reservar Clases
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container pb-5">
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4 gap-3">
        <div>
            <h2 class="fw-bold text-white mb-1">
                <i class="bi bi-trophy text-warning me-2"></i>Evolución Corporal & Avances Físicos
            </h2>
            <p class="text-secondary small mb-0">Histórico de mediciones y gráficos de composición biológica</p>
        </div>
        <button class="btn btn-purple btn-sm" onclick="alert('Solicitando nueva evaluación bioimpedancia a Marcus Vance...')">
            <i class="bi bi-clipboard-plus me-1"></i> Solicitar Medición
        </button>
    </div>

    <!-- TARJETAS DE INDICADORES FÍSICOS CLAVE -->
    <div class="row g-4 mb-4">
        <div class="col-md-3 col-6">
            <div class="saas-card p-4 text-center h-100">
                <span class="text-muted small fw-bold text-uppercase d-block mb-1">Peso Actual</span>
                <div class="display-6 fw-bold text-white mb-1">78.5 kg</div>
                <span class="saas-badge saas-badge-success">-4.0 kg total</span>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="saas-card p-4 text-center h-100">
                <span class="text-muted small fw-bold text-uppercase d-block mb-1">% Grasa Corporal</span>
                <div class="display-6 fw-bold text-white mb-1">14.2%</div>
                <span class="saas-badge saas-badge-success">-4.0% grasa</span>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="saas-card p-4 text-center h-100">
                <span class="text-muted small fw-bold text-uppercase d-block mb-1">Masa Muscular</span>
                <div class="display-6 fw-bold text-white mb-1">41.8 kg</div>
                <span class="saas-badge saas-badge-purple">+2.1 kg músculo</span>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="saas-card p-4 text-center h-100">
                <span class="text-muted small fw-bold text-uppercase d-block mb-1">Cintura</span>
                <div class="display-6 fw-bold text-white mb-1">81 cm</div>
                <span class="saas-badge saas-badge-success">-6 cm reducido</span>
            </div>
        </div>
    </div>

    <!-- DOS GRÁFICOS INTERACTIVOS GRANDES DE EVOLUCIÓN -->
    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="saas-card p-4 h-100">
                <h5 class="fw-bold text-white mb-3">
                    <i class="bi bi-graph-up text-primary me-2"></i>Evolución de Peso (kg) y Masa Muscular
                </h5>
                <div style="position: relative; height: 280px;">
                    <canvas id="chartPesoMusculo"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="saas-card p-4 h-100">
                <h5 class="fw-bold text-white mb-3">
                    <i class="bi bi-pie-chart text-success me-2"></i>Evolución de Perímetros Musculares (cm)
                </h5>
                <div style="position: relative; height: 280px;">
                    <canvas id="chartMedidas"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- TABLA DE HISTORIAL DE EVALUACIONES FÍSICAS -->
    <div class="saas-card overflow-hidden">
        <div class="p-3 bg-dark border-bottom border-secondary">
            <h5 class="fw-bold text-white mb-0">Historial de Evaluaciones Biométricas</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-saas mb-0">
                <thead>
                    <tr>
                        <th>Fecha Evaluación</th>
                        <th>Peso (kg)</th>
                        <th>% Grasa</th>
                        <th>Masa Muscular</th>
                        <th>Tórax</th>
                        <th>Cintura</th>
                        <th>Bíceps</th>
                        <th>Evaluador</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-white">15/07/2024</td>
                        <td>78.5 kg</td>
                        <td><span class="badge bg-success">14.2%</span></td>
                        <td>41.8 kg</td>
                        <td>104 cm</td>
                        <td>81 cm</td>
                        <td>38.5 cm</td>
                        <td>Marcus Vance</td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-white">15/05/2024</td>
                        <td>80.2 kg</td>
                        <td>16.8%</td>
                        <td>40.5 kg</td>
                        <td>102 cm</td>
                        <td>84 cm</td>
                        <td>37.8 cm</td>
                        <td>Marcus Vance</td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-white">15/03/2024</td>
                        <td>82.5 kg</td>
                        <td>18.2%</td>
                        <td>39.7 kg</td>
                        <td>100 cm</td>
                        <td>87 cm</td>
                        <td>37.0 cm</td>
                        <td>Marcus Vance</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Chart 1: Peso vs Músculo
            new Chart(document.getElementById('chartPesoMusculo').getContext('2d'), {
                type: 'line',
                data: {
                    labels: ['Marzo', 'Mayo', 'Julio'],
                    datasets: [
                        {
                            label: 'Peso Total (kg)',
                            data: [82.5, 80.2, 78.5],
                            borderColor: '#8B3DFF',
                            backgroundColor: 'rgba(139, 61, 255, 0.15)',
                            fill: true,
                            tension: 0.3
                        },
                        {
                            label: 'Masa Muscular (kg)',
                            data: [39.7, 40.5, 41.8],
                            borderColor: '#3B82F6',
                            borderWidth: 2,
                            tension: 0.3
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { labels: { color: '#ffffff' } } },
                    scales: {
                        x: { ticks: { color: '#C9C9C9' }, grid: { color: 'rgba(255,255,255,0.1)' } },
                        y: { ticks: { color: '#C9C9C9' }, grid: { color: 'rgba(255,255,255,0.1)' } }
                    }
                }
            });

            // Chart 2: Medidas corporales
            new Chart(document.getElementById('chartMedidas').getContext('2d'), {
                type: 'bar',
                data: {
                    labels: ['Tórax', 'Cintura', 'Bíceps'],
                    datasets: [
                        { label: 'Marzo', data: [100, 87, 37.0], backgroundColor: 'rgba(138, 138, 138, 0.5)' },
                        { label: 'Julio', data: [104, 81, 38.5], backgroundColor: '#22C55E' }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { labels: { color: '#ffffff' } } },
                    scales: {
                        x: { ticks: { color: '#C9C9C9' }, grid: { color: 'rgba(255,255,255,0.1)' } },
                        y: { ticks: { color: '#C9C9C9' }, grid: { color: 'rgba(255,255,255,0.1)' } }
                    }
                }
            });
        });
    </script>
}
