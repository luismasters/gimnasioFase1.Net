@{
    ViewData["Title"] = "Mi Evolución Física y Métricas - AppGimn Premium";
}

<div class="cliente-layout">
    <partial name="_ClienteSidebar" />

    <div class="cliente-content-canvas">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4 gap-3">
            <div>
                <h1 class="fw-bold text-dark mb-1" style="font-size: 2.1rem; letter-spacing: -0.02em;">
                    <i class="bi bi-graph-up-arrow text-purple me-2" style="color: #8B3DFF;"></i>Evolución Corporal & Avances Físicos
                </h1>
                <p class="text-muted small mb-0">Histórico de mediciones y gráficos de composición biológica</p>
            </div>
            <button class="btn btn-purple btn-sm py-2 px-3 fw-bold" onclick="alert('Solicitando nueva evaluación bioimpedancia a Marcus Vance...')">
                <i class="bi bi-clipboard-plus me-1"></i> Solicitar Medición
            </button>
        </div>

        <!-- TARJETAS DE INDICADORES FÍSICOS CLAVE -->
        <div class="row g-4 mb-4">
            <div class="col-md-3 col-6">
                <div class="card-white text-center h-100">
                    <span class="text-muted small fw-bold text-uppercase d-block mb-1">Peso Actual</span>
                    <div class="display-6 fw-bold text-dark mb-1">78.5 kg</div>
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">-4.0 kg total</span>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="card-white text-center h-100">
                    <span class="text-muted small fw-bold text-uppercase d-block mb-1">% Grasa Corporal</span>
                    <div class="display-6 fw-bold text-dark mb-1">14.2%</div>
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">-4.0% grasa</span>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="card-white text-center h-100">
                    <span class="text-muted small fw-bold text-uppercase d-block mb-1">Masa Muscular</span>
                    <div class="display-6 fw-bold text-dark mb-1">41.8 kg</div>
                    <span class="badge bg-purple-subtle text-light border border-purple rounded-pill" style="background: rgba(139, 61, 255, 0.2);">+2.1 kg músculo</span>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="card-white text-center h-100">
                    <span class="text-muted small fw-bold text-uppercase d-block mb-1">Cintura</span>
                    <div class="display-6 fw-bold text-dark mb-1">81 cm</div>
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">-6 cm reducido</span>
                </div>
            </div>
        </div>

        <!-- DOS GRÁFICOS INTERACTIVOS GRANDES DE EVOLUCIÓN -->
        <div class="row g-4 mb-4">
            <div class="col-lg-6">
                <div class="card-white h-100">
                    <h5 class="fw-bold text-dark mb-3">
                        <i class="bi bi-graph-up text-purple me-2" style="color: #8B3DFF;"></i>Evolución de Peso (kg) y Masa Muscular
                    </h5>
                    <div style="position: relative; height: 280px;">
                        <canvas id="chartPesoMusculo"></canvas>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card-white h-100">
                    <h5 class="fw-bold text-dark mb-3">
                        <i class="bi bi-pie-chart text-success me-2"></i>Evolución de Perímetros Musculares (cm)
                    </h5>
                    <div style="position: relative; height: 280px;">
                        <canvas id="chartMedidas"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- TABLA DE HISTORIAL DE EVALUACIONES FÍSICAS -->
        <div class="card-white overflow-hidden p-0">
            <div class="p-3 bg-light border-bottom border-slate-200">
                <h5 class="fw-bold text-dark mb-0">Historial de Evaluaciones Biométricas</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Fecha Evaluación</th>
                            <th>Peso (kg)</th>
                            <th>% Grasa</th>
                            <th>Masa Muscular</th>
                            <th>Tórax</th>
                            <th>Cintura</th>
                            <th>Bíceps</th>
                            <th>Evaluador</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="fw-bold text-dark">15/07/2024</td>
                            <td>78.5 kg</td>
                            <td><span class="badge bg-success">14.2%</span></td>
                            <td>41.8 kg</td>
                            <td>104 cm</td>
                            <td>81 cm</td>
                            <td>38.5 cm</td>
                            <td>Marcus Vance</td>
                        </tr>
                        <tr>
                            <td class="fw-bold text-dark">15/05/2024</td>
                            <td>80.2 kg</td>
                            <td>16.8%</td>
                            <td>40.5 kg</td>
                            <td>102 cm</td>
                            <td>84 cm</td>
                            <td>37.8 cm</td>
                            <td>Marcus Vance</td>
                        </tr>
                        <tr>
                            <td class="fw-bold text-dark">15/03/2024</td>
                            <td>82.5 kg</td>
                            <td>18.2%</td>
                            <td>39.7 kg</td>
                            <td>100 cm</td>
                            <td>87 cm</td>
                            <td>37.0 cm</td>
                            <td>Marcus Vance</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Chart 1: Peso vs Músculo
            new Chart(document.getElementById('chartPesoMusculo').getContext('2d'), {
                type: 'line',
                data: {
                    labels: ['Marzo', 'Mayo', 'Julio'],
                    datasets: [
                        {
                            label: 'Peso Total (kg)',
                            data: [82.5, 80.2, 78.5],
                            borderColor: '#8B3DFF',
                            backgroundColor: 'rgba(139, 61, 255, 0.15)',
                            fill: true,
                            tension: 0.3
                        },
                        {
                            label: 'Masa Muscular (kg)',
                            data: [39.7, 40.5, 41.8],
                            borderColor: '#3B82F6',
                            borderWidth: 2,
                            tension: 0.3
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { labels: { color: '#0f172a' } } },
                    scales: {
                        x: { ticks: { color: '#64748b' }, grid: { color: '#e2e8f0' } },
                        y: { ticks: { color: '#64748b' }, grid: { color: '#e2e8f0' } }
                    }
                }
            });

            // Chart 2: Medidas corporales
            new Chart(document.getElementById('chartMedidas').getContext('2d'), {
                type: 'bar',
                data: {
                    labels: ['Tórax', 'Cintura', 'Bíceps'],
                    datasets: [
                        { label: 'Marzo', data: [100, 87, 37.0], backgroundColor: '#cbd5e1' },
                        { label: 'Julio', data: [104, 81, 38.5], backgroundColor: '#22C55E' }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { labels: { color: '#0f172a' } } },
                    scales: {
                        x: { ticks: { color: '#64748b' }, grid: { color: '#e2e8f0' } },
                        y: { ticks: { color: '#64748b' }, grid: { color: '#e2e8f0' } }
                    }
                }
            });
        });
    </script>
}
