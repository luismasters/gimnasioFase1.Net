@{
    ViewData["Title"] = "Reserva de Clases Grupales - AppGimn Premium";
}

<div class="cliente-layout">
    <partial name="_ClienteSidebar" />

    <div class="cliente-content-canvas">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4 gap-3">
            <div>
                <h1 class="fw-bold text-dark mb-1" style="font-size: 2.1rem; letter-spacing: -0.02em;">
                    <i class="bi bi-calendar-range text-purple me-2" style="color: #8B3DFF;"></i>Cartelera de Clases y Reservas
                </h1>
                <p class="text-muted small mb-0">Reserva tu cupo para las actividades del día en Aura Fitness Club</p>
            </div>
            <div class="card-white p-2.5 text-dark small fw-semibold m-0 d-inline-flex align-items-center gap-2">
                <i class="bi bi-ticket-perforated-fill text-warning fs-5"></i> Créditos Disponibles: <strong>Ilimitados (Pase VIP)</strong>
            </div>
        </div>

        <!-- TARJETAS VISUALES DE CLASES CON FOTOGRAFÍA -->
        <div class="row g-4">
            <!-- CLASE 1: PILATES REFORMER -->
            <div class="col-md-6 col-lg-4">
                <div class="card-white overflow-hidden h-100 p-0 d-flex flex-column justify-content-between">
                    <div>
                        <div class="position-relative">
                            <img src="~/images/landing/group_classes.jpg" alt="Pilates Reformer" class="w-100" style="height: 200px; object-fit: cover;" />
                            <span class="position-absolute top-0 end-0 m-3 badge bg-success text-white px-3 py-1.5 rounded-pill">HOY 18:00 HS</span>
                        </div>
                        <div class="p-4">
                            <h4 class="fw-bold text-dark mb-1">Pilates Reformer & Postura</h4>
                            <p class="text-muted small mb-3">Instructora: Elena Rostova | Salón Principal A</p>
                            
                            <div class="d-flex align-items-center justify-content-between mb-2 small text-muted">
                                <span>Cupos ocupados:</span>
                                <span class="text-dark fw-bold">14 / 18 lugares</span>
                            </div>
                            <div class="progress mb-3" style="height: 6px; background-color: #e2e8f0;">
                                <div class="progress-bar bg-success" style="width: 77%;"></div>
                            </div>
                        </div>
                    </div>
                    <div class="p-4 pt-0">
                        <button class="btn btn-purple w-100 py-2.5 fw-bold" onclick="alert('¡Lugar reservado con éxito para Pilates Reformer (18:00 hs)!')">
                            <i class="bi bi-check-circle-fill me-1"></i> Reservar Mi Lugar
                        </button>
                    </div>
                </div>
            </div>

            <!-- CLASE 2: CARDIO BIOMÉTRICO HIIT -->
            <div class="col-md-6 col-lg-4">
                <div class="card-white overflow-hidden h-100 p-0 d-flex flex-column justify-content-between">
                    <div>
                        <div class="position-relative">
                            <img src="~/images/landing/cardio_area.jpg" alt="Cardio HIIT" class="w-100" style="height: 200px; object-fit: cover;" />
                            <span class="position-absolute top-0 end-0 m-3 badge bg-purple text-white px-3 py-1.5 rounded-pill" style="background-color: #8B3DFF;">HOY 19:30 HS</span>
                        </div>
                        <div class="p-4">
                            <h4 class="fw-bold text-dark mb-1">HIIT & Intervalos Biométricos</h4>
                            <p class="text-muted small mb-3">Instructor: Lucas Rodríguez | Zona Cardio 360°</p>

                            <div class="d-flex align-items-center justify-content-between mb-2 small text-muted">
                                <span>Cupos ocupados:</span>
                                <span class="text-dark fw-bold">10 / 15 lugares</span>
                            </div>
                            <div class="progress mb-3" style="height: 6px; background-color: #e2e8f0;">
                                <div class="progress-bar bg-purple" style="width: 66%; background-color: #8B3DFF;"></div>
                            </div>
                        </div>
                    </div>
                    <div class="p-4 pt-0">
                        <button class="btn btn-purple w-100 py-2.5 fw-bold" onclick="alert('¡Lugar reservado con éxito para HIIT & Intervalos Biométricos (19:30 hs)!')">
                            <i class="bi bi-check-circle-fill me-1"></i> Reservar Mi Lugar
                        </button>
                    </div>
                </div>
            </div>

            <!-- CLASE 3: SPINNING CYCLING -->
            <div class="col-md-6 col-lg-4">
                <div class="card-white overflow-hidden h-100 p-0 d-flex flex-column justify-content-between">
                    <div>
                        <div class="position-relative">
                            <img src="~/images/landing/aura_hero.jpg" alt="Spinning" class="w-100" style="height: 200px; object-fit: cover;" />
                            <span class="position-absolute top-0 end-0 m-3 badge bg-purple text-white px-3 py-1.5 rounded-pill" style="background-color: #8B3DFF;">MAÑANA 08:00 HS</span>
                        </div>
                        <div class="p-4">
                            <h4 class="fw-bold text-dark mb-1">Pro Cycling & Endurance</h4>
                            <p class="text-muted small mb-3">Instructor: Marcus Vance | Salón de Spinning</p>

                            <div class="d-flex align-items-center justify-content-between mb-2 small text-muted">
                                <span>Cupos ocupados:</span>
                                <span class="text-dark fw-bold">8 / 20 lugares</span>
                            </div>
                            <div class="progress mb-3" style="height: 6px; background-color: #e2e8f0;">
                                <div class="progress-bar bg-info" style="width: 40%;"></div>
                            </div>
                        </div>
                    </div>
                    <div class="p-4 pt-0">
                        <button class="btn btn-purple w-100 py-2.5 fw-bold" onclick="alert('¡Lugar reservado con éxito para Pro Cycling (Mañana 08:00 hs)!')">
                            <i class="bi bi-check-circle-fill me-1"></i> Reservar Mi Lugar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
