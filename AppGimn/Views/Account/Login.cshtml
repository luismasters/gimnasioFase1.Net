@model AppGimn.Models.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Iniciar Sesión - AppGimn Premium";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    
    <!-- Fonts & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Custom Design System -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-split-page">

    <div class="container-fluid p-0">
        <div class="row g-0 min-vh-100">
            <!-- COLUMNA IZQUIERDA: HERO CON IMAGEN Y FRASES (50% DESKTOP) -->
            <div class="col-lg-6 login-split-hero">
                <!-- LOGO SUPERIOR -->
                <a class="login-hero-brand" asp-controller="Home" asp-action="Index">
                    <div class="brand-badge-purple">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <span>App<span style="color: var(--primary-light);">Gimn</span></span>
                </a>

                <!-- TARJETA FLOTANTE DE PREVISUALIZACIÓN (MOCKUP) -->
                <div class="login-hero-preview-container">
                    <div class="login-hero-preview-card">
                        <div class="text-center mb-3">
                            <div class="d-inline-flex align-items-center justify-content-center bg-purple text-white rounded-circle mb-2" style="width: 42px; height: 42px; background: #8B3DFF;">
                                <i class="bi bi-activity fs-5"></i>
                            </div>
                            <h6 class="fw-bold text-white mb-0">AppGimn SaaS</h6>
                            <span class="badge bg-white bg-opacity-20 text-white rounded-pill px-2 py-1" style="font-size: 0.7rem;">Iniciar Sesión</span>
                        </div>
                        <div class="mb-2">
                            <div class="bg-white bg-opacity-10 rounded-3 p-2 d-flex align-items-center gap-2 text-white-50" style="font-size: 0.8rem;">
                                <i class="bi bi-envelope"></i> nombre@tu-gimnasio.com
                            </div>
                        </div>
                        <div class="mb-3">
                            <div class="bg-white bg-opacity-10 rounded-3 p-2 d-flex align-items-center justify-content-between text-white-50" style="font-size: 0.8rem;">
                                <span><i class="bi bi-lock"></i> ••••••••</span>
                                <i class="bi bi-eye-slash opacity-50"></i>
                            </div>
                        </div>
                        <div class="d-grid mb-2">
                            <div class="btn btn-sm text-white fw-bold rounded-3 py-2" style="background: #8B3DFF; font-size: 0.85rem;">
                                Iniciar Sesión
                            </div>
                        </div>
                        <div class="text-center text-white-50" style="font-size: 0.72rem;">
                            ¿No tienes cuenta? <span class="text-white text-decoration-underline">Registrarse</span>
                        </div>
                    </div>
                </div>

                <!-- SECCIÓN INFERIOR DE TEXTO IMPACTANTE -->
                <div class="login-hero-footer">
                    <h1 class="login-hero-title">Gestiona tu gimnasio con precisión.</h1>
                    <p class="login-hero-desc">
                        Únete a los centros de fitness de primer nivel que utilizan AppGimn para optimizar operaciones, fidelizar socios e impulsar el crecimiento.
                    </p>
                </div>
            </div>

            <!-- COLUMNA DERECHA: FORMULARIO DE LOGIN SOBRIO (50% DESKTOP) -->
            <div class="col-lg-6 login-split-form-wrapper">
                
                <!-- BOTÓN SUPERIOR PARA VOLVER AL INICIO -->
                <div class="position-absolute top-0 end-0 p-4">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-2 text-decoration-none fw-semibold">
                        <i class="bi bi-house me-1"></i> Volver al Inicio
                    </a>
                </div>

                <div class="login-form-box">
                    <!-- ENCABEZADO -->
                    <h2 class="login-form-title">Bienvenido de nuevo</h2>
                    <p class="login-form-subtitle">Por favor ingresa tus datos para acceder a tu panel.</p>

                    <!-- ALERTA DE ERROR TEMP DATA -->
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
                            <i class="bi bi-exclamation-circle-fill me-2"></i> @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-action="Login" method="post" id="loginForm">
                        <input type="hidden" asp-for="ReturnUrl" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3 p-2 rounded-3"></div>

                        <!-- CAMPO CORREO ELECTRÓNICO -->
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label text-dark fw-semibold mb-1" style="font-size: 0.88rem;">Correo electrónico</label>
                            <div class="login-input-group">
                                <i class="bi bi-envelope login-input-icon"></i>
                                <input asp-for="Email" id="emailInput" class="form-control" placeholder="nombre@tu-gimnasio.com" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small ms-1"></span>
                        </div>

                        <!-- CAMPO CONTRASEÑA CON BOTÓN OJO -->
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label text-dark fw-semibold mb-1" style="font-size: 0.88rem;">Contraseña</label>
                            <div class="login-input-group">
                                <i class="bi bi-lock login-input-icon"></i>
                                <input asp-for="Password" id="passwordInput" class="form-control" placeholder="••••••••" />
                                <button type="button" class="login-toggle-password" id="togglePasswordBtn" title="Mostrar/ocultar contraseña">
                                    <i class="bi bi-eye-slash" id="togglePasswordIcon"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small ms-1"></span>
                        </div>

                        <!-- OPCIONES DE RECORDAR Y RECUPERAR -->
                        <div class="d-flex align-items-center justify-content-between mb-4" style="font-size: 0.88rem;">
                            <div class="form-check m-0">
                                <input asp-for="RememberMe" class="form-check-input" id="rememberMeCheck" />
                                <label asp-for="RememberMe" class="form-check-label text-secondary fw-medium">
                                    Mantener sesión iniciada
                                </label>
                            </div>
                            <a href="#" data-bs-toggle="modal" data-bs-target="#forgotPasswordModal" class="text-decoration-none fw-bold" style="color: #8B3DFF;">
                                ¿Olvidaste tu contraseña?
                            </a>
                        </div>

                        <!-- BOTÓN INICIAR SESIÓN -->
                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-login-submit">
                                Iniciar Sesión
                            </button>
                        </div>

                        <!-- BOTÓN ACCESO DEMO RÁPIDO -->
                        <div class="d-grid mb-4">
                            <button type="button" class="btn btn-login-demo" data-bs-toggle="modal" data-bs-target="#demoAccessModal">
                                <i class="bi bi-lightning-charge-fill me-1 text-warning"></i> Acceso Demo Rápido
                            </button>
                        </div>
                    </form>

                    <!-- ENLACE A REGISTRO / SOPORTE -->
                    <div class="text-center pt-2" style="font-size: 0.9rem;">
                        <span class="text-secondary me-1">¿No tienes una cuenta?</span>
                        <a asp-action="Register" class="fw-bold text-decoration-none" style="color: #8B3DFF;">
                            Contactar Ventas
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL ACCESO DEMO RÁPIDO -->
    <div class="modal fade" id="demoAccessModal" tabindex="-1" aria-labelledby="demoAccessModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold text-dark" id="demoAccessModalLabel">
                        <i class="bi bi-lightning-charge-fill text-warning me-2"></i>Selecciona un Perfil para la Demo
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted small mb-3">Ingresa con 1 solo clic como cualquiera de los roles disponibles en AppGimn:</p>
                    
                    <div class="d-grid gap-2 mb-3">
                        <a asp-action="QuickLogin" asp-route-role="admin" class="btn btn-outline-dark p-3 text-start d-flex align-items-center justify-content-between rounded-3">
                            <div>
                                <div class="fw-bold text-purple"><i class="bi bi-shield-lock-fill me-2"></i> Administrador / Dueño</div>
                                <div class="small text-muted">Acceso total a reportes, finanzas, empleados y configuración.</div>
                            </div>
                            <i class="bi bi-arrow-right-short fs-4"></i>
                        </a>

                        <a asp-action="QuickLogin" asp-route-role="recepcion" class="btn btn-outline-dark p-3 text-start d-flex align-items-center justify-content-between rounded-3">
                            <div>
                                <div class="fw-bold text-info"><i class="bi bi-display me-2"></i> Recepcionista</div>
                                <div class="small text-muted">Terminal de Check-in DNI, cobro de cuotas y padrón de socios.</div>
                            </div>
                            <i class="bi bi-arrow-right-short fs-4"></i>
                        </a>

                        <a asp-action="QuickLogin" asp-route-role="instructor" class="btn btn-outline-dark p-3 text-start d-flex align-items-center justify-content-between rounded-3">
                            <div>
                                <div class="fw-bold text-success"><i class="bi bi-activity me-2"></i> Entrenador / Instructor</div>
                                <div class="small text-muted">Gestión de rutinas, planes de entrenamiento y evaluaciones.</div>
                            </div>
                            <i class="bi bi-arrow-right-short fs-4"></i>
                        </a>

                        <a asp-action="QuickLogin" asp-route-role="cliente" class="btn btn-outline-dark p-3 text-start d-flex align-items-center justify-content-between rounded-3">
                            <div>
                                <div class="fw-bold text-primary"><i class="bi bi-person-badge-fill me-2"></i> Cliente / Socio</div>
                                <div class="small text-muted">Portal de socio, estado de cuota, rutinas y clases reservadas.</div>
                            </div>
                            <i class="bi bi-arrow-right-short fs-4"></i>
                        </a>
                    </div>

                    <div class="text-center pt-2">
                        <button type="button" class="btn btn-link btn-sm text-secondary text-decoration-none" onclick="fillAdminCredentials()" data-bs-dismiss="modal">
                            <i class="bi bi-pencil-square me-1"></i> Cargar datos de Admin en el formulario
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL OLVIDÓ CONTRASEÑA -->
    <div class="modal fade" id="forgotPasswordModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold text-dark">Recuperar Contraseña</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted small">Para restablecer tu contraseña en el entorno de demostración, por favor contacta al administrador del sistema o utiliza el menú de <strong>Acceso Demo Rápido</strong>.</p>
                    <div class="d-grid">
                        <button type="button" class="btn btn-secondary rounded-3" data-bs-dismiss="modal">Entendido</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        // JS para alternar la visibilidad de la contraseña
        document.addEventListener('DOMContentLoaded', function () {
            const toggleBtn = document.getElementById('togglePasswordBtn');
            const passwordInput = document.getElementById('passwordInput');
            const toggleIcon = document.getElementById('togglePasswordIcon');

            if (toggleBtn && passwordInput && toggleIcon) {
                toggleBtn.addEventListener('click', function () {
                    const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
                    passwordInput.setAttribute('type', type);
                    
                    if (type === 'text') {
                        toggleIcon.classList.remove('bi-eye-slash');
                        toggleIcon.classList.add('bi-eye');
                    } else {
                        toggleIcon.classList.remove('bi-eye');
                        toggleIcon.classList.add('bi-eye-slash');
                    }
                });
            }
        });

        function fillAdminCredentials() {
            document.getElementById('emailInput').value = 'admin@gimnasio.com';
            document.getElementById('passwordInput').value = 'Admin123!';
        }
    </script>
</body>
</html>