@model AppGimn.Models.Empleado

@{
    ViewData["Title"] = "Nuevo Empleado - AppGimn";
}

<div class="row justify-content-center py-3">
    <div class="col-lg-8">
        <div class="saas-card p-4 p-md-5">
            <div class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom border-secondary opacity-75">
                <div>
                    <h3 class="fw-bold text-white mb-1">
                        <i class="bi bi-person-badge-fill text-primary me-2"></i>Registrar Nuevo Empleado
                    </h3>
                    <p class="text-secondary small mb-0">Ingresa los datos personales, asignación de cargo y salario</p>
                </div>
                <a asp-action="Index" class="btn btn-secondary-saas btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Volver al Listado
                </a>
            </div>

            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Nombre" class="form-label"></label>
                        <input asp-for="Nombre" class="form-control" placeholder="Ej. Ana" />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Apellido" class="form-label"></label>
                        <input asp-for="Apellido" class="form-control" placeholder="Ej. Martínez" />
                        <span asp-validation-for="Apellido" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="DNI" class="form-label"></label>
                        <input asp-for="DNI" class="form-control" placeholder="44556677" />
                        <span asp-validation-for="DNI" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Cargo" class="form-label"></label>
                        <select asp-for="Cargo" class="form-select">
                            <option value="">-- Seleccionar Cargo --</option>
                            <option value="Gerente">Gerente</option>
                            <option value="Recepcionista">Recepcionista</option>
                            <option value="Entrenador">Entrenador</option>
                            <option value="Mantenimiento">Mantenimiento</option>
                        </select>
                        <span asp-validation-for="Cargo" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Telefono" class="form-label"></label>
                        <input asp-for="Telefono" class="form-control" placeholder="+54 11 5566-7788" />
                        <span asp-validation-for="Telefono" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" placeholder="ana.martinez@gimnasio.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="FechaIngreso" class="form-label"></label>
                        <input asp-for="FechaIngreso" class="form-control" type="date" />
                        <span asp-validation-for="FechaIngreso" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Salario" class="form-label"></label>
                        <input asp-for="Salario" class="form-control" type="number" step="0.01" placeholder="180000" />
                        <span asp-validation-for="Salario" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Observaciones" class="form-label"></label>
                    <textarea asp-for="Observaciones" class="form-control" rows="3" placeholder="Horarios, turno, especificaciones de contrato..."></textarea>
                    <span asp-validation-for="Observaciones" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-purple btn-lg px-4">
                        <i class="bi bi-check-circle-fill me-1"></i> Guardar Empleado
                    </button>
                    <a asp-action="Index" class="btn btn-secondary-saas btn-lg px-4">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}