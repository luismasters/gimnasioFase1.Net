@model IEnumerable<AppGimn.Models.Empleado>

@{
    ViewData["Title"] = "Gestión de Empleados - AppGimn Premium";
    var filtroActual = ViewData["FiltroActual"] as string;
    var filtroCargo = ViewData["FiltroCargo"] as string;
    var cargosDisponibles = ViewData["CargosDisponibles"] as List<string>;

    int totalEmpleados = Model?.Count() ?? 0;
    int instructores = Model?.Count(e => (e.Cargo ?? "").ToLower().Contains("instructor") || (e.Cargo ?? "").ToLower().Contains("entrenador")) ?? 0;
    int recepcion = Model?.Count(e => (e.Cargo ?? "").ToLower().Contains("recepc")) ?? 0;
    decimal masaSalarial = Model?.Where(e => e.EstaActivo && e.Salario.HasValue).Sum(e => e.Salario ?? 0) ?? 0;
}

<div class="container py-4">
    <!-- ENCABEZADO -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4 gap-3">
        <div>
            <h2 class="fw-bold text-white mb-1">
                <i class="bi bi-person-workspace text-primary me-2"></i>Gestión de Personal & Plantilla
            </h2>
            <p class="text-secondary small mb-0">Control de personal, asignación de cargos, masa salarial y permisos</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-purple py-2 px-3 fw-bold">
                <i class="bi bi-person-plus-fill me-1"></i> Registrar Nuevo Empleado
            </a>
        </div>
    </div>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success bg-dark border-success text-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> <strong>¡Éxito!</strong> @TempData["MensajeExito"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- METRIC STAT CARDS DE EMPLEADOS -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="saas-card p-3 d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted small fw-bold text-uppercase">Total Plantilla</div>
                    <div class="fs-3 fw-bold text-white mb-0">@totalEmpleados</div>
                </div>
                <div class="brand-badge-purple" style="width: 44px; height: 44px; font-size: 1.25rem;">
                    <i class="bi bi-people-fill"></i>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="saas-card p-3 d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted small fw-bold text-uppercase">Instructores / Coaches</div>
                    <div class="fs-3 fw-bold text-info mb-0">@instructores</div>
                </div>
                <div class="rounded-3 bg-info bg-opacity-20 text-info d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; font-size: 1.25rem;">
                    <i class="bi bi-activity"></i>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="saas-card p-3 d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted small fw-bold text-uppercase">Recepción</div>
                    <div class="fs-3 fw-bold text-warning mb-0">@recepcion</div>
                </div>
                <div class="rounded-3 bg-warning bg-opacity-20 text-warning d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; font-size: 1.25rem;">
                    <i class="bi bi-display"></i>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="saas-card p-3 d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted small fw-bold text-uppercase">Masa Salarial Muestra</div>
                    <div class="fs-4 fw-bold text-success mb-0">@masaSalarial.ToString("C")</div>
                </div>
                <div class="rounded-3 bg-success bg-opacity-20 text-success d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; font-size: 1.25rem;">
                    <i class="bi bi-cash-stack"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- TARJETA DE BUSCADOR Y FILTROS POR CARGO -->
    <div class="saas-card p-4 mb-4">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label text-muted small fw-bold">
                    <i class="bi bi-search me-1"></i> BUSCAR POR NOMBRE, DNI O EMAIL
                </label>
                <input type="text" name="buscar" class="form-control"
                       value="@filtroActual" placeholder="Escribe para buscar..." />
            </div>
            <div class="col-md-4">
                <label class="form-label text-muted small fw-bold">
                    <i class="bi bi-funnel me-1"></i> FILTRAR POR CARGO
                </label>
                <select name="cargo" class="form-select">
                    <option value="">-- Todos los cargos --</option>
                    @if (cargosDisponibles != null)
                    {
                        foreach (var c in cargosDisponibles)
                        {
                            <option value="@c" selected="@(c == filtroCargo)">@c</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-purple flex-grow-1 fw-bold">
                    <i class="bi bi-search me-1"></i> Filtrar
                </button>
                <a asp-action="Index" class="btn btn-secondary-saas">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- TABLA DE EMPLEADOS -->
    <div class="saas-card overflow-hidden">
        <div class="table-responsive">
            <table class="table table-saas mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Empleado</th>
                        <th>DNI</th>
                        <th>Cargo</th>
                        <th>Contacto</th>
                        <th>Fecha Ingreso</th>
                        <th>Salario Base</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold text-white">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle bg-secondary-subtle text-white d-inline-flex align-items-center justify-content-center flex-shrink-0" style="width: 38px; height: 38px; font-size: 1.1rem;">
                                        <i class="bi bi-person-badge"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-white">@item.NombreCompleto</div>
                                        <small class="text-muted d-block" style="font-size: 0.75rem;">Legajo #EMP-@item.Id</small>
                                    </div>
                                </div>
                            </td>
                            <td><code class="text-light fs-6">@item.DNI</code></td>
                            <td>
                                <span class="badge bg-purple-subtle text-light border border-purple px-2 py-1" style="background: rgba(139, 61, 255, 0.2);">
                                    @item.Cargo
                                </span>
                            </td>
                            <td>
                                <div class="small">
                                    <div><i class="bi bi-telephone text-muted me-1"></i>@(item.Telefono ?? "-")</div>
                                    <div class="text-muted"><i class="bi bi-envelope text-muted me-1"></i>@(item.Email ?? "-")</div>
                                </div>
                            </td>
                            <td class="small text-muted">
                                @item.FechaIngreso.ToString("dd/MM/yyyy")
                            </td>
                            <td class="fw-bold text-success">
                                @(item.Salario.HasValue ? item.Salario.Value.ToString("C") : "-")
                            </td>
                            <td>
                                @if (item.EstaActivo)
                                {
                                    <span class="saas-badge saas-badge-success">
                                        <i class="bi bi-check-circle-fill"></i> Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="saas-badge saas-badge-danger">
                                        <i class="bi bi-x-circle-fill"></i> Inactivo
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-secondary-saas" title="Ver Detalle">
                                        <i class="bi bi-eye text-info"></i> Ficha
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-secondary-saas" title="Editar">
                                        <i class="bi bi-pencil text-warning"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 mb-3 d-block opacity-50 text-purple"></i>
                            No se encontraron empleados registrados en la plantilla.
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>