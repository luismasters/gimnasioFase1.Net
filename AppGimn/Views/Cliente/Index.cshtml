@model IEnumerable<AppGimn.Models.Cliente>

@{
    ViewData["Title"] = "Gestión de Clientes - AppGimn Premium";
}

<div class="recepcion-layout">
    <partial name="_RecepcionSidebar" />

    <div class="recepcion-content container-fluid px-lg-4 py-4 pb-5">
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4 gap-3">
        <div>
            <h2 class="fw-bold text-white mb-1">
                <i class="bi bi-people text-primary me-2"></i>Gestión de Clientes
            </h2>
            <p class="text-secondary small mb-0">Administra y consulta la información del alumnado del gimnasio</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-purple">
                <i class="bi bi-person-plus me-1"></i> Registrar Nuevo Cliente
            </a>
        </div>
    </div>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success bg-dark border-success text-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> <strong>¡Éxito!</strong> @TempData["MensajeExito"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- FILTER & SEARCH CARD -->
    <div class="saas-card p-4 mb-4">
        <form asp-action="Index" method="get">
            <div class="row g-3 align-items-center">
                <div class="col-md-8">
                    <div class="input-group">
                        <span class="input-group-text bg-dark border-secondary text-muted">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" name="buscar" value="@ViewData["FiltroActual"]"
                               class="form-control" placeholder="Buscar por nombre, apellido, DNI o email..." />
                    </div>
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-purple flex-grow-1">
                        <i class="bi bi-search me-1"></i> Buscar
                    </button>
                    <a asp-action="Index" class="btn btn-secondary-saas">
                        <i class="bi bi-arrow-counterclockwise"></i> Limpiar
                    </a>
                </div>
            </div>
        </form>
    </div>

    <!-- CLIENTS TABLE CARD -->
    <div class="saas-card overflow-hidden">
        <div class="table-responsive">
            <table class="table table-saas mb-0">
                <thead>
                    <tr>
                        <th>Socio</th>
                        <th>DNI</th>
                        <th>Edad</th>
                        <th>Suscripción</th>
                        <th>Cuota</th>
                        <th>Teléfono</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        var plan = ((Dictionary<int, string>)ViewBag.PlanDict).GetValueOrDefault(item.Id, "Sin plan");
                        var cuotaAlDia = ((Dictionary<int, bool>)ViewBag.EstadoSuscripcionDict).GetValueOrDefault(item.Id, false);
                        <tr>
                            <td class="fw-semibold text-white">
                                <div class="d-flex align-items-center gap-2">
                                    @{ ViewBag.AvatarSize = 36; }
                                    <partial name="_ClienteAvatar" model="item" />
                                    @item.NombreCompleto
                                </div>
                            </td>
                            <td><code class="text-light">@item.DNI</code></td>
                            <td>@item.Edad años</td>
                            <td>
                                <span class="text-light">@plan</span>
                            </td>
                            <td>
                                @if (cuotaAlDia)
                                {
                                    <span class="saas-badge saas-badge-success">
                                        <i class="bi bi-check-circle-fill"></i> Activa
                                    </span>
                                }
                                else
                                {
                                    <span class="saas-badge saas-badge-danger">
                                        <i class="bi bi-x-circle-fill"></i> Vencida
                                    </span>
                                }
                            </td>
                            <td>@(item.Telefono ?? "-")</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-secondary-saas" title="Ver Detalle">
                                        <i class="bi bi-eye text-info"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-secondary-saas" title="Editar">
                                        <i class="bi bi-pencil text-warning"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-secondary-saas" title="Eliminar/Desactivar">
                                        <i class="bi bi-trash text-danger"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fa-3x mb-3 d-block opacity-50"></i>
                            No se encontraron clientes registrados o coincidentes con la búsqueda.
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
    </div>
</div>