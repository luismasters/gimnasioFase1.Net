@model AppGimn.Models.Cliente

@{
    ViewData["Title"] = "Detalle del Cliente - AppGimn";
}

<div class="row justify-content-center py-3">
    <div class="col-lg-8">
        <div class="saas-card p-4 p-md-5">
            <div class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom border-secondary opacity-75">
                <div>
                    <span class="saas-badge @(Model.EstaActivo ? "saas-badge-success" : "saas-badge-danger") mb-2">
                        @(Model.EstaActivo ? "Cliente Activo" : "Cliente Inactivo")
                    </span>
                    <h3 class="fw-bold text-white mb-0">@Model.NombreCompleto</h3>
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-purple btn-sm">
                        <i class="bi bi-pencil me-1"></i> Editar
                    </a>
                    <a asp-action="Index" class="btn btn-secondary-saas btn-sm">
                        <i class="bi bi-arrow-left me-1"></i> Volver
                    </a>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-md-6">
                    <div class="saas-card p-3" style="background-color: var(--bg-surface-variant);">
                        <span class="text-muted small fw-bold text-uppercase d-block mb-1">DNI</span>
                        <div class="fs-5 text-white fw-bold"><code>@Model.DNI</code></div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="saas-card p-3" style="background-color: var(--bg-surface-variant);">
                        <span class="text-muted small fw-bold text-uppercase d-block mb-1">Edad</span>
                        <div class="fs-5 text-white fw-bold">@Model.Edad años <span class="text-muted fs-6 font-normal">(Nacido/a el @Model.FechaNacimiento.ToString("dd/MM/yyyy"))</span></div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="saas-card p-3" style="background-color: var(--bg-surface-variant);">
                        <span class="text-muted small fw-bold text-uppercase d-block mb-1">Teléfono</span>
                        <div class="fs-6 text-white"><i class="bi bi-telephone text-primary me-2"></i>@(Model.Telefono ?? "No registrado")</div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="saas-card p-3" style="background-color: var(--bg-surface-variant);">
                        <span class="text-muted small fw-bold text-uppercase d-block mb-1">Email</span>
                        <div class="fs-6 text-white"><i class="bi bi-envelope text-primary me-2"></i>@(Model.Email ?? "No registrado")</div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="saas-card p-3" style="background-color: var(--bg-surface-variant);">
                        <span class="text-muted small fw-bold text-uppercase d-block mb-1">Fecha de Inscripción</span>
                        <div class="fs-6 text-white"><i class="bi bi-calendar-check text-success me-2"></i>@Model.FechaInscripcion.ToString("dd/MM/yyyy")</div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="saas-card p-3" style="background-color: var(--bg-surface-variant);">
                        <span class="text-muted small fw-bold text-uppercase d-block mb-1">Contacto de Emergencia</span>
                        <div class="fs-6 text-white"><i class="bi bi-shield-exclamation text-warning me-2"></i>@(Model.ContactoEmergencia ?? "No registrado")</div>
                    </div>
                </div>

                <div class="col-12">
                    <div class="saas-card p-3" style="background-color: var(--bg-surface-variant);">
                        <span class="text-muted small fw-bold text-uppercase d-block mb-1">Observaciones Médicas / Ficha Médica</span>
                        <p class="text-white mb-0 small">
                            @(string.IsNullOrWhiteSpace(Model.ObservacionesMedicas) ? "Sin observaciones médicas registradas." : Model.ObservacionesMedicas)
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>