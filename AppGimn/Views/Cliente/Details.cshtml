@model AppGimn.Models.Cliente

@{
    ViewData["Title"] = "Detalle del Cliente - AppGimn Premium";
}

<div class="recepcion-layout">
    <partial name="_RecepcionSidebar" />

    <div class="recepcion-content container-fluid px-lg-4 py-4 pb-5">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="saas-card p-4 p-md-5">
                    <!-- CABECERA DE FICHA -->
                    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4 pb-3 border-bottom border-secondary opacity-75 gap-3">
                        <div>
                            <span class="saas-badge @(Model.EstaActivo ? "saas-badge-success" : "saas-badge-danger") mb-2">
                                <i class="bi @(Model.EstaActivo ? "bi-check-circle-fill" : "bi-x-circle-fill") me-1"></i>
                                @(Model.EstaActivo ? "Socio Activo" : "Socio Inactivo")
                            </span>
                            <h2 class="fw-bold text-white mb-0">@Model.NombreCompleto</h2>
                            <small class="text-secondary">DNI: <code class="text-light fs-6">@Model.DNI</code></small>
                        </div>
                        <div class="d-flex flex-wrap gap-2">
                            <a asp-controller="Dashboard" asp-action="RecepcionCobros" asp-route-busquedaDni="@Model.DNI" class="btn btn-success py-2 px-3 fw-bold">
                                <i class="bi bi-cash-coin me-1"></i> Cobrar Cuota
                            </a>
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-purple py-2 px-3 fw-bold">
                                <i class="bi bi-pencil me-1"></i> Editar Ficha
                            </a>
                            <a asp-action="Index" class="btn btn-secondary-saas py-2 px-3">
                                <i class="bi bi-arrow-left me-1"></i> Volver al Padrón
                            </a>
                        </div>
                    </div>

                    <div class="row g-4">
                        <!-- COLUMNA AVATAR / TARJETA VIP -->
                        <div class="col-md-4">
                            <div class="saas-card p-4 text-center h-100 d-flex flex-column justify-content-between" style="background-color: var(--bg-surface-variant);">
                                <div>
                                    <div class="mx-auto mb-3" style="width: 140px; height: 140px;">
                                        @{ ViewBag.AvatarSize = 140; }
                                        <partial name="_ClienteAvatar" model="Model" />
                                    </div>
                                    <h4 class="fw-bold text-white mb-1">@Model.NombreCompleto</h4>
                                    <p class="text-secondary small mb-3">Socio de AURA FITNESS CLUB</p>
                                    
                                    <div class="p-3 bg-white rounded-3 mx-auto mb-3 d-inline-block shadow-sm">
                                        <img src="https://api.qrserver.com/v1/create-qr-code/?size=120x120&data=AURA-SOCIO-@Model.DNI" alt="Código QR de Acceso" style="width: 120px; height: 120px;" />
                                    </div>
                                    <div class="small text-muted mb-0"><i class="bi bi-qr-code me-1"></i> Carnet Digital de Ingreso</div>
                                </div>
                                <div class="mt-3 pt-3 border-top border-secondary">
                                    <span class="small text-muted d-block">Fecha de Alta</span>
                                    <span class="fw-bold text-white"><i class="bi bi-calendar-check text-success me-1"></i>@Model.FechaInscripcion.ToString("dd/MM/yyyy")</span>
                                </div>
                            </div>
                        </div>

                        <!-- COLUMNA DATOS COMPLETOS -->
                        <div class="col-md-8">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="saas-card p-3" style="background-color: var(--bg-surface-variant);">
                                        <span class="text-muted small fw-bold text-uppercase d-block mb-1">Número de DNI</span>
                                        <div class="fs-5 text-white fw-bold"><code>@Model.DNI</code></div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="saas-card p-3" style="background-color: var(--bg-surface-variant);">
                                        <span class="text-muted small fw-bold text-uppercase d-block mb-1">Edad & Nacimiento</span>
                                        <div class="fs-6 text-white fw-bold">@Model.Edad años <span class="text-muted fs-6 font-normal">(@Model.FechaNacimiento.ToString("dd/MM/yyyy"))</span></div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="saas-card p-3" style="background-color: var(--bg-surface-variant);">
                                        <span class="text-muted small fw-bold text-uppercase d-block mb-1">Teléfono de Contacto</span>
                                        <div class="fs-6 text-white"><i class="bi bi-telephone text-primary me-2"></i>@(Model.Telefono ?? "No registrado")</div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="saas-card p-3" style="background-color: var(--bg-surface-variant);">
                                        <span class="text-muted small fw-bold text-uppercase d-block mb-1">Correo Electrónico</span>
                                        <div class="fs-6 text-white"><i class="bi bi-envelope text-primary me-2"></i>@(Model.Email ?? "No registrado")</div>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <div class="saas-card p-3" style="background-color: var(--bg-surface-variant);">
                                        <span class="text-muted small fw-bold text-uppercase d-block mb-1">Contacto de Emergencia</span>
                                        <div class="fs-6 text-white"><i class="bi bi-shield-exclamation text-warning me-2"></i>@(Model.ContactoEmergencia ?? "No registrado")</div>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <div class="saas-card p-3" style="background-color: var(--bg-surface-variant);">
                                        <span class="text-muted small fw-bold text-uppercase d-block mb-1">Ficha Médica & Observaciones</span>
                                        <p class="text-white mb-0 small">
                                            @(string.IsNullOrWhiteSpace(Model.ObservacionesMedicas) ? "Sin observaciones médicas ni restricciones declaradas." : Model.ObservacionesMedicas)
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>