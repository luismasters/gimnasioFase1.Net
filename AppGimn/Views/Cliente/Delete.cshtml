@model AppGimn.Models.Cliente

@{
    ViewData["Title"] = $"Eliminar Cliente: {Model.NombreCompleto}";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h3 class="card-title mb-0">
                        <i class="fas fa-exclamation-triangle"></i> Confirmar Eliminación
                    </h3>
                </div>

                <div class="card-body">
                    <div class="alert alert-warning" role="alert">
                        <h5 class="alert-heading">
                            <i class="fas fa-exclamation-triangle"></i> ¡Atención!
                        </h5>
                        <p class="mb-0">
                            Estás a punto de <strong>eliminar permanentemente</strong> este cliente.
                            Esta acción <strong>no se puede deshacer</strong>.
                        </p>
                    </div>

                    <!-- Resumen del cliente a eliminar -->
                    <div class="card">
                        <div class="card-body">
                            <h5 class="text-primary mb-3">
                                <i class="fas fa-user"></i> Cliente a Eliminar
                            </h5>

                            <div class="row">
                                <div class="col-md-6">
                                    <dl class="row">
                                        <dt class="col-sm-6">Nombre Completo:</dt>
                                        <dd class="col-sm-6"><strong>@Model.NombreCompleto</strong></dd>

                                        <dt class="col-sm-6">DNI:</dt>
                                        <dd class="col-sm-6">@Model.DNI</dd>

                                        <dt class="col-sm-6">Edad:</dt>
                                        <dd class="col-sm-6">@Model.Edad años</dd>

                                        <dt class="col-sm-6">Estado:</dt>
                                        <dd class="col-sm-6">
                                            @if (Model.EstaActivo)
                                            {
                                                <span class="badge badge-success">Activo</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-secondary">Inactivo</span>
                                            }
                                        </dd>
                                    </dl>
                                </div>

                                <div class="col-md-6">
                                    <dl class="row">
                                        <dt class="col-sm-6">Teléfono:</dt>
                                        <dd class="col-sm-6">
                                            @if (!string.IsNullOrEmpty(Model.Telefono))
                                            {
                                                @Model.Telefono
                                            }
                                            else
                                            {
                                                <span class="text-muted">No especificado</span>
                                            }
                                        </dd>

                                        <dt class="col-sm-6">Email:</dt>
                                        <dd class="col-sm-6">
                                            @if (!string.IsNullOrEmpty(Model.Email))
                                            {
                                                @Model.Email
                                            }
                                            else
                                            {
                                                <span class="text-muted">No especificado</span>
                                            }
                                        </dd>

                                        <dt class="col-sm-6">Inscripción:</dt>
                                        <dd class="col-sm-6">@Model.FechaInscripcion.ToString("dd/MM/yyyy")</dd>

                                        <dt class="col-sm-6">Días como miembro:</dt>
                                        <dd class="col-sm-6">@((DateTime.Now - Model.FechaInscripcion).Days) días</dd>
                                    </dl>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(Model.ObservacionesMedicas))
                            {
                                <div class="row mt-3">
                                    <div class="col-12">
                                        <dl class="row">
                                            <dt class="col-sm-3">Observaciones Médicas:</dt>
                                            <dd class="col-sm-9">
                                                <div class="alert alert-warning small" role="alert">
                                                    <i class="fas fa-notes-medical"></i>
                                                    @Model.ObservacionesMedicas
                                                </div>
                                            </dd>
                                        </dl>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Información sobre el borrado lógico -->
                    <div class="mt-3">
                        <div class="alert alert-success" role="alert">
                            <h6 class="alert-heading">
                                <i class="fas fa-recycle"></i> ¿No era lo que buscabas?
                            </h6>
                            <p class="mb-0">
                                El cliente se puede <strong>reactivar fácilmente</strong> desde el listado principal.
                                Los datos están completamente seguros.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Botones de confirmación -->
                <div class="card-footer">
                    <form asp-action="Delete" method="post" class="d-inline">
                        <input asp-for="Id" type="hidden" />

                        <div class="row">
                            <div class="col-md-6">
                                <button type="submit" class="btn btn-danger btn-block"
                                        onclick="return confirm('¿Estás completamente seguro de eliminar este cliente? Esta acción NO se puede deshacer.')">
                                    <i class="fas fa-trash"></i>
                                    SÍ, Eliminar Permanentemente
                                </button>
                            </div>

                            <div class="col-md-6">
                                <div class="btn-group btn-block" role="group">
                                    <a asp-action="Edit" asp-route-id="@Model.Id"
                                       class="btn btn-warning">
                                        <i class="fas fa-user-slash"></i> Marcar Inactivo
                                    </a>

                                    <a asp-action="Details" asp-route-id="@Model.Id"
                                       class="btn btn-info">
                                        <i class="fas fa-eye"></i> Ver Detalles
                                    </a>
                                </div>
                            </div>
                        </div>

                        <div class="text-center mt-3">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Cancelar y Volver al Listado
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>