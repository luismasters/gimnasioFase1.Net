@model AppGimn.Models.Cliente

@{
    ViewData["Title"] = "Eliminar Cliente - AppGimn";
}

<div class="row justify-content-center py-4">
    <div class="col-lg-6">
        <div class="saas-card p-4 p-md-5 border-danger">
            <div class="text-center mb-4">
                <div class="rounded-circle bg-danger-subtle text-danger mx-auto d-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px; font-size: 1.8rem;">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>
                <h3 class="fw-bold text-white mb-1">Confirmar Eliminación</h3>
                <p class="text-secondary small">¿Estás seguro de que deseas eliminar este cliente del sistema?</p>
            </div>

            <div class="saas-card p-4 mb-4 text-center" style="background-color: var(--bg-surface-variant);">
                <div class="mb-3">
                    @{ ViewBag.AvatarSize = 96; }
                    <partial name="_ClienteAvatar" model="Model" />
                </div>
                <div class="h5 fw-bold text-white mb-2">@Model.NombreCompleto</div>
                <div class="small text-secondary mb-1"><strong>DNI:</strong> <code>@Model.DNI</code></div>
                <div class="small text-secondary mb-1"><strong>Email:</strong> @(Model.Email ?? "-")</div>
                <div class="small text-secondary"><strong>Fecha Inscripción:</strong> @Model.FechaInscripcion.ToString("dd/MM/yyyy")</div>
            </div>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-danger btn-lg py-3 fw-bold">
                        <i class="bi bi-trash-fill me-1"></i> Sí, Eliminar Definitivamente
                    </button>
                    <a asp-action="Index" class="btn btn-secondary-saas btn-lg py-3 text-center">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>