@{
    ViewData["Title"] = "AppGimn Premium - Plataforma SaaS de Gestión Fitness";
}

<!-- 1. HERO SECTION (SaaS Presentation) -->
<section class="hero-section-saas">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <span class="saas-badge saas-badge-purple mb-3">
                    <i class="bi bi-shield-check"></i> PLATAFORMA SAAS PARA GIMNASIOS PREMIUM
                </span>
                <h1 class="display-4 fw-extrabold text-white mb-3 text-uppercase" style="letter-spacing: -1px; line-height: 1.15;">
                    Elegancia, Orden y Control para tu Gimnasio
                </h1>
                <p class="text-secondary fs-5 mb-4" style="line-height: 1.6;">
                    La solución integral diseñada para centros fitness de alto rendimiento. 
                    Administra socios, entrenadores, membresías y analíticas operativas con la máxima precisión y sofisticación.
                </p>

                <div class="d-flex flex-wrap gap-3 mb-4">
                    <!-- BOTÓN PRINCIPAL VER DEMO -->
                    <a asp-controller="Home" asp-action="Demo" class="btn btn-purple btn-lg px-4 py-3 fs-5">
                        <i class="bi bi-play-circle-fill me-2"></i> VER DEMO EN VIVO
                    </a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-secondary-saas btn-lg px-4 py-3">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión
                    </a>
                </div>

                <div class="d-flex align-items-center gap-4 pt-3 border-top border-secondary opacity-75">
                    <div>
                        <div class="h4 fw-bold text-white mb-0">100%</div>
                        <div class="small text-muted">Control Operativo</div>
                    </div>
                    <div class="border-end border-secondary pe-4" style="height: 30px;"></div>
                    <div>
                        <div class="h4 fw-bold text-white mb-0">24 / 7</div>
                        <div class="small text-muted">Disponibilidad Cloud</div>
                    </div>
                    <div class="border-end border-secondary pe-4" style="height: 30px;"></div>
                    <div>
                        <div class="h4 fw-bold text-white mb-0">.NET 8</div>
                        <div class="small text-muted">Arquitectura Enterprise</div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="saas-card overflow-hidden p-2">
                    <img src="~/images/landing/gym_hero.jpg" 
                         alt="Instalaciones del Gimnasio Premium AppGimn" 
                         class="img-16-9" />
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 2. BENEFICIOS CLAVE -->
<section id="beneficios" class="py-5" style="background-color: var(--bg-surface);">
    <div class="container py-4">
        <div class="text-center mb-5 max-w-700 mx-auto">
            <span class="saas-badge saas-badge-purple mb-2">POR QUÉ ELEGIRNOS</span>
            <h2 class="fw-bold text-white display-6">Diseñado para la Excelencia Operativa</h2>
            <p class="text-secondary">Todo lo que necesitas para ofrecer un servicio distinguido a tus socios</p>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="saas-card p-4 h-100">
                    <div class="brand-badge-purple mb-3">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <h5 class="fw-bold text-white mb-2">Control Total 360°</h5>
                    <p class="text-secondary small mb-0">
                        Gestión centralizada del alumnado, fichas médicas, contactos de emergencia y estado de membresías en tiempo real.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="saas-card p-4 h-100">
                    <div class="brand-badge-purple mb-3">
                        <i class="bi bi-lightning-charge-fill"></i>
                    </div>
                    <h5 class="fw-bold text-white mb-2">Flujo Ultrarrápido</h5>
                    <p class="text-secondary small mb-0">
                        Interfaz limpia, ágil y sin fricción pensada para la recepción y gerencia. Búsqueda instantánea por DNI o nombre.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="saas-card p-4 h-100">
                    <div class="brand-badge-purple mb-3">
                        <i class="bi bi-lock-fill"></i>
                    </div>
                    <h5 class="fw-bold text-white mb-2">Seguridad Enterprise</h5>
                    <p class="text-secondary small mb-0">
                        Autenticación sólida basada en ASP.NET Core Identity, permisos por perfil y cifrado de datos extremo a extremo.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 3. SERVICIOS E INSTALACIONES (GALERÍA 16:9) -->
<section id="servicios" class="py-5">
    <div class="container py-4">
        <div class="d-flex flex-column flex-md-row align-items-md-end justify-content-between mb-5 gap-3">
            <div>
                <span class="saas-badge saas-badge-purple mb-2">INSTALACIONES PREMIUM</span>
                <h2 class="fw-bold text-white display-6 mb-0">Espacios de Alto Rendimiento</h2>
            </div>
            <p class="text-secondary mb-0 max-w-500">
                Equipamiento de última generación y ambientes diseñados para una experiencia fitness insuperable.
            </p>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="saas-card overflow-hidden h-100">
                    <img src="~/images/landing/weight_training.jpg" 
                         alt="Zona de Musculación y Pesas Libres" 
                         class="img-16-9" />
                    <div class="p-4">
                        <h5 class="fw-bold text-white mb-2">Zona de Musculación</h5>
                        <p class="text-muted small mb-0">
                            Pesas libres, mancuernas de precisión y maquinaria biomecánica de alta gama.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="saas-card overflow-hidden h-100">
                    <img src="~/images/landing/cardio_area.jpg" 
                         alt="Área de Cardio Biométrico" 
                         class="img-16-9" />
                    <div class="p-4">
                        <h5 class="fw-bold text-white mb-2">Área de Cardio Biométrico</h5>
                        <p class="text-muted small mb-0">
                            Cintas, remos y elípticas interconectadas con monitoreo de rendimiento personal.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="saas-card overflow-hidden h-100">
                    <img src="~/images/landing/group_classes.jpg" 
                         alt="Estudio de Clases Grupales y Funcional" 
                         class="img-16-9" />
                    <div class="p-4">
                        <h5 class="fw-bold text-white mb-2">Estudios de Clases Grupales</h5>
                        <p class="text-muted small mb-0">
                            Salones acondicionados para pilates, yoga, HIIT y entrenamiento funcional guiado.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 4. PLANES DE MEMBRESÍA -->
<section id="planes" class="py-5" style="background-color: var(--bg-surface);">
    <div class="container py-4">
        <div class="text-center mb-5">
            <span class="saas-badge saas-badge-purple mb-2">MEMBRESÍAS</span>
            <h2 class="fw-bold text-white display-6">Planes Diseñados a tu Medida</h2>
            <p class="text-secondary">Elige la opción que mejor se adapte a tus objetivos de entrenamiento</p>
        </div>

        <div class="row g-4 justify-content-center">
            <!-- Plan Estándar -->
            <div class="col-lg-4 col-md-6">
                <div class="saas-card p-4 d-flex flex-column h-100">
                    <h5 class="fw-bold text-white mb-1">Pase Estándar</h5>
                    <p class="text-muted small mb-3">Ideal para entrenamientos regulares</p>
                    <div class="mb-4">
                        <span class="display-5 fw-bold text-white">$45</span>
                        <span class="text-muted">/ mes</span>
                    </div>

                    <ul class="list-unstyled text-secondary small d-flex flex-column gap-2.5 mb-4 flex-grow-1">
                        <li><i class="bi bi-check-lg text-primary me-2"></i>Acceso a sala de musculación</li>
                        <li><i class="bi bi-check-lg text-primary me-2"></i>Ficha de socio digital</li>
                        <li><i class="bi bi-check-lg text-primary me-2"></i>Horarios regulares de atención</li>
                    </ul>

                    <a asp-controller="Home" asp-action="Demo" class="btn btn-secondary-saas w-100">
                        Probar en la Demo
                    </a>
                </div>
            </div>

            <!-- Plan Premium (Destacado) -->
            <div class="col-lg-4 col-md-6">
                <div class="saas-card saas-card-featured p-4 d-flex flex-column h-100">
                    <h5 class="fw-bold text-white mb-1">Pase Premium</h5>
                    <p class="text-muted small mb-3">La experiencia fitness más completa</p>
                    <div class="mb-4">
                        <span class="display-5 fw-bold text-white">$75</span>
                        <span class="text-muted">/ mes</span>
                    </div>

                    <ul class="list-unstyled text-secondary small d-flex flex-column gap-2.5 mb-4 flex-grow-1">
                        <li><i class="bi bi-check-lg text-primary me-2"></i>Acceso 24/7 a todas las áreas</li>
                        <li><i class="bi bi-check-lg text-primary me-2"></i>Clases grupales ilimitadas</li>
                        <li><i class="bi bi-check-lg text-primary me-2"></i>Evaluación biométrica mensual</li>
                        <li><i class="bi bi-check-lg text-primary me-2"></i>Asesoría inicial de entrenador</li>
                    </ul>

                    <a asp-controller="Home" asp-action="Demo" class="btn btn-purple w-100">
                        Probar en la Demo
                    </a>
                </div>
            </div>

            <!-- Plan VIP -->
            <div class="col-lg-4 col-md-6">
                <div class="saas-card p-4 d-flex flex-column h-100">
                    <h5 class="fw-bold text-white mb-1">Pase VIP & Corporativo</h5>
                    <p class="text-muted small mb-3">Atención personalizada exclusiva</p>
                    <div class="mb-4">
                        <span class="display-5 fw-bold text-white">$120</span>
                        <span class="text-muted">/ mes</span>
                    </div>

                    <ul class="list-unstyled text-secondary small d-flex flex-column gap-2.5 mb-4 flex-grow-1">
                        <li><i class="bi bi-check-lg text-primary me-2"></i>Todo lo incluido en Pase Premium</li>
                        <li><i class="bi bi-check-lg text-primary me-2"></i>Entrenador personal dedicado</li>
                        <li><i class="bi bi-check-lg text-primary me-2"></i>Locker privado reservado</li>
                    </ul>

                    <a asp-controller="Home" asp-action="Demo" class="btn btn-secondary-saas w-100">
                        Probar en la Demo
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 5. BANNER CTA FINAL CON VER DEMO -->
<section class="py-5 mb-4">
    <div class="container">
        <div class="saas-card p-5 text-center" style="background-color: var(--bg-surface-variant);">
            <div class="max-w-700 mx-auto">
                <span class="saas-badge saas-badge-purple mb-3">EXPERIENCIA INTERACTIVA</span>
                <h2 class="fw-bold text-white display-6 mb-3">
                    Explora el Gimnasio Ficticio "Aura Fitness Club"
                </h2>
                <p class="text-secondary mb-4 fs-5">
                    Ingresa a la demo interactiva personalizada para ver cómo luce el sistema en un gimnasio real con accesos, entrenadores y catálogo completo.
                </p>
                <div class="d-flex flex-wrap justify-content-center gap-3">
                    <a asp-controller="Home" asp-action="Demo" class="btn btn-purple btn-lg px-5 py-3 fs-5">
                        <i class="bi bi-play-circle-fill me-2"></i> INGRESAR A LA DEMO AURA FITNESS
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>